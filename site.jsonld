{"@graph":[{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/","identifier":"content:dao-studio-home","@type":"WebPage","name":"DAO Studio","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"Make AI useful through composed applications, coordinated response and capabilities others can build upon.","dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"A mechanical owl with camera-like eyes and intricately connected parts.\nFront Left Right Up Down\nSee what matters. Act with clarity.\nConnect the right information with the people who need to act, from responding to an incident to putting AI to work across your organisation.\nYOJN Care\nBring the person asking for help, the evidence and the response team together.\nYojnAI\nConnect models, tools and your organisation’s knowledge in AI applications your team can guide.\nDAOnet\nA protocol design for finding and reusing AI capabilities with their context and conditions understood; no marketplace runs.\nQuestions about the products\nHow can we discuss a product or purchase?\nThe products are paused. DAO Studio’s products remain available through RawThoughts consulting. Bring your requirements to discuss purchase, delivery scope and licensing with RTEPL.\nHow do the three products differ?\nYOJN Care connects the people and evidence needed for a continuing response. YojnAI gives teams a composition they can inspect and improve. DAOnet carries reusable capability across applications. Each solves a different coordination problem; they need not be adopted as one platform.\nWhere can I read more about the work?\nThe inquiries develop incident coordination, application composition and reuse. About DAO Studio connects those questions to the studio’s purpose, people and consulting route.\nFrom a conversation to useful work\nAn answer is one part of an AI application. The records it uses, the work it carries out and the way a team can inspect and improve it determine whether it becomes useful in everyday operation.\nExplore application composition\nCapability beyond one application\nReusing another team’s AI work means understanding its context, dependencies and conditions of use. Follow the protocols and continuing relationships that let useful capability travel between applications.\nExplore protocols and reuse\nPeople around a response\nA detection becomes useful when the evidence, the reviewer and the next responder stay connected. Follow how a response is carried from request to action.\nExplore coordinating emergencies\n","image":[{"@type":"ImageObject","contentUrl":"https://daostudio.in/assets/renditions/owl/poses/front.webp","description":"A mechanical owl with camera-like eyes and intricately connected parts."}],"url":"https://daostudio.in/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"mentions":[{"@id":"https://daostudio.in/daonet/#entity","identifier":"project:daonet","@type":"CreativeWork","name":"DAOnet","subjectOf":[{"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","url":"https://daostudio.in/daonet/"},{"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/"},{"@id":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","@type":"CollectionPage","name":"DAOnet mentions","url":"https://daostudio.in/daonet/mentions/"}]},{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]},{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/about/","identifier":"content:dao-studio-about","@type":"AboutPage","name":"About DAO Studio","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"How an ambition to help people create decentralised, autonomous organisations became three ways to make AI capability useful.","text":"Make useful AI something people can build with, understand and improve.\nDAO Studio connects product development, consulting and research around that purpose. Its founding ambition was to help people create decentralised, autonomous organisations, inspired by Amul and Lijjat Papad. Shared capability could give a smaller organisation more to build with, while leaving people more time for meaningful work and relationships.\nThe ambition was non-zero-sum: helping one business grow should make more possible for the others around it. The studio would help build and maintain that shared network as its guardian, not its owner. Its early focus was small and medium businesses and women in tier-2 and tier-3 India, with simpler access to useful services and more control over their time and data.\nAs the work moved into AI, that ambition became a mission to democratise AI and commoditise intelligence. A useful capability should fit the work people actually do, let them contribute what they know and become easier for another team to adopt. YOJN became the name around which the studio explored explainability, controllability, decomposability and interoperability: understanding an answer, guiding it, working with its parts and connecting it to other systems.\nThree ways to make capability useful\nFrom detection to response\nYOJN Care connects the person asking for help, the monitored site and the response team around one incident. Personal SOS, camera evidence and human review help the next person understand what happened and carry the response onward. It is a product for response teams, not an emergency service; if you need help now, call your local emergency number.\nYOJN Care\nThe application around the model\nYojnAI connects models, tools, agents and checked playbooks to an organisation’s records and services. People can supply missing context, inspect the work behind an answer and use feedback to decide what to improve.\nYojnAI\nSharing useful capability\nDAOnet is a protocol design for letting a useful capability travel beyond its first application; no marketplace runs. Receiving teams can find it, configure it for their work and keep its context across requests. Contributors and receiving teams share an account of the exchange, so both can follow what was used and what happened.\nDAOnet\nA service can solve one team’s problem. A product should let the useful part accumulate.\nConsulting starts with an organisation’s records, rules and continuing work. Turning service work into reusable capability means finding the mechanism another team can adopt while each customer keeps their own context. A product then carries the learning forward, making the next adoption easier.\nAn accessible AI service needs the organisation behind the conversation.\nA natural conversation can make a service easier to reach. Behind it, people still need to supply business knowledge, inspect an unexpected result and correct the operation. Care, YojnAI and DAOnet address distinct parts of that work: human response, composed applications and capability shared between teams.\nPeople, products and a route into your work.\nHarsh Joshi and Shashwat Pandey founded DAO Studio in October 2022. Care grew from Harsh’s earlier work leading product and engineering at Sachait, an emergency-response company; YojnAI reached pilots in investment banking, operations and the CFO office. Those experiences connect the studio’s product questions to Harsh’s wider work on making complex systems useful to people.\nDAO Studio Private Limited (DSPL) owns the studio and its products. It is legally separate from RawThoughts Enterprises Private Limited (RTEPL). The products are paused. Work on them is available through RTEPL consulting engagements; enquiries and purchase conversations go through RawThoughts’ services. Any delivery and licensing must be agreed for the particular engagement.\n","url":"https://daostudio.in/about/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/blog/","identifier":"content:dao-studio-articles","@type":"CollectionPage","name":"Blog","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"mainEntity":{"@type":"ItemList","numberOfItems":4,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/#article","@type":"Article","url":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/","identifier":"content:dao-studio-service-to-reusable-capability","name":"Turning service work into reusable capability"}},{"@type":"ListItem","position":2,"item":{"@id":"https://daostudio.in/blog/follow-the-data/#article","@type":"TechArticle","url":"https://daostudio.in/blog/follow-the-data/","identifier":"content:dao-studio-self-hosted-is-not-a-data-map","name":"Follow the data, not the deployment label"}},{"@type":"ListItem","position":3,"item":{"@id":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/#article","@type":"Article","url":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/","identifier":"content:dao-studio-less-interface-more-visible-control","name":"Evolution of AI, and its future in B2B"}},{"@type":"ListItem","position":4,"item":{"@id":"https://daostudio.in/blog/the-organisation-around-the-ai/#article","@type":"Article","url":"https://daostudio.in/blog/the-organisation-around-the-ai/","identifier":"content:dao-studio-the-organisation-around-the-ai","name":"The organisation around the AI"}}],"itemListOrder":"https://schema.org/ItemListOrderDescending"},"description":"Composition, feedback, response and the questions behind DAO Studio's work.","text":"","url":"https://daostudio.in/blog/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/#article","identifier":"content:dao-studio-less-interface-more-visible-control","@type":"Article","name":"Evolution of AI, and its future in B2B","headline":"Evolution of AI, and its future in B2B","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["AI front desk","No UI","AI in B2B","AI controllability","AI explainability","AI-first workflows","customer retention"],"mainEntityOfPage":{"@id":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/","@type":"WebPage","name":"Evolution of AI, and its future in B2B","url":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/"},"description":"From the Doordarshan antenna to an AI front desk: why control, explanation, efficiency and the knowledge inside a business have to develop together.","datePublished":{"@value":"2024-05-04","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"Evolution of AI, and its future in B2B\nSize matters. How you use it matters more. But first, let's zoom out.\nWhen I was young, I grew up watching Doordarshan. Every Saturday evening, our family sat together to watch Jai Hanuman, and we woke up to Chitrahar on Sundays. When the signal was noisy, one of us (it was always me) went upstairs, climbed onto the roof and adjusted the antenna. A Yagi–Uda antenna, for the electronics geek. No remote, one channel, a few knobs and a twisted piece of metal on the roof.\nFast-forward twenty-five years. Each family member can watch the show they want, and any one of them can become a creator. A new release announces itself through a device vibrating on the desk. It knows something about what you want and when you want it. It fits in your pocket. You can talk to a larger community watching the same thing, live, with Super Chats. Yes, YouTube.\nTV became YouTube. Radio became Spotify. We stopped flipping horizontally through pages about celebrities and started scrolling vertically through the carefully presented lives of our own friends and family. Yes, Instagram. Broadcasting, radio and print continued alongside them. The change reaches our habits and our thinking. Twenty-five years of technological evolution brought societal evolution with it. Now we have iPad babies, and children whose social accounts exist before they are born. You get the gist.\nThis is not merely the journey from Pentium to the M4 Singularity Blaster Pro Max. Nor is it only the journey from a computer in a garage to Google. It is the journey from the horizontal flip to the vertical scroll: different ways of finding something, paying attention to it and participating in it.\nTelevision ratings acquired neighbours in engagement and reach. Those metrics helped organise targeted advertising around attention. A new interface became part of a different economy. That is the level at which I want to look at AI's future in business.\nI first wrote this argument in May 2024. The voice-platform and efficiency forecasts below belong to that outlook; the question behind them is what a business would need before it could trust AI to become its front desk.\nThe front desk\nSoftware has made many things easier while giving us another thing to learn: its interface. Moving from television to YouTube reduced the need for buttons on a physical device but introduced menus, search, subscriptions and settings on a screen. What if the next step let the customer begin with what they wanted, without first learning how the business had arranged its software?\nThe best UI is No UI, taken as a direction rather than a ban on screens. An AI front desk, if you will. You say what you need. It understands enough about you, the service and the situation to help you get it. The film Her offered a familiar image of that conversational entrance. Voice is one possibility; accessibility and the task still determine which other ways of interacting the person needs.\nThis is the front desk your customers encounter. The rest of the business works to empower it. Only now it can be hosted on the internet and reached wherever the customer is.\nDistribution could change with it. We reached services through browsers, then app stores. I imagined mobile operating systems becoming large voice-assistant platforms, with apps turning into capabilities those assistants could discover and invoke. Your front desk would be distributed as one of those capabilities. Or something to that effect. I do not have a crystal ball, and my psychic powers were never strong enough to resolve the details.\nDistribution and retention are two of a business's enduring problems. Getting into a new distribution channel early could matter, although it would leave businesses with new questions about who controls access to their customers. Retention is where the front desk becomes particularly interesting: it can carry the continuing relationship, rather than just help somebody find the entrance.\nSize matters. How you use it matters more\nRepeat after me: simply making the model bigger is not how this works.\nThink about a process full of conditions and loops. It repeats, but each customer's situation needs a personal adjustment. It depends on people joining and leaving the organisation, remembering exceptions and maintaining the automation. You can end up with a million combinations to develop and maintain, and still make the customer feel like an awkward exception to a form.\nAI offers an automation of some of that automation: a way to interpret variation without someone spelling out every possible conversation beforehand. Retention is expensive, risky and continuous. This is the work I expected the front desk to scale first.\nA plausible conversation is the beginning. Confidence in putting it in front of customers needs several other things to develop together.\nFirst, teach it when to shut up\nA system that is good at talking also needs to know what it should not say, what it does not know and when somebody else needs to decide. Part of that is controllability; part concerns the model and architecture through which the work happens.\nIn 2024, I expected reinforcement learning and better planning to change what those architectures could do. The surrounding application still has to decide what the system may read, promise and change, and check that it honours those rules.\nThink of an operating system. Agent orchestration arranges work somewhat like threads; tools give those activities ways to interact with the world. The growing number of tools makes creating the first demonstration easier. Choosing among them can become a task in itself.\nThen the demonstration meets production. Guardrails and checks have to become more precise and keep up as customer interactions grow. A rule that worked for one prepared example has to encounter the unexpected request, the ambiguous instruction and the customer whose circumstances have changed. Scaling the useful control is harder than adding another conversation window.\nConsider an invented exchange. A customer says, “Move my delivery to the address I used last time.” There are two recent addresses, and the parcel is already in transit. The front desk needs to ask which address, establish what the carrier still permits and distinguish requesting the change from confirming it. A fluent “Done” would be the easiest answer to generate and the wrong promise to make.\nThe useful interface might be a conversation followed by a visible card showing the parcel, chosen address and “Request the change.” The person can inspect the proposed change without first reconstructing the business's internal navigation.\nPerformance-review your front desk\nYou do not hand out bonuses without looking at the work. Nor do you fire the people who are doing it well. You assess, talk, explain what needs to improve and give people a way to improve it.\nThe AI front desk needs an equivalent route for examining its work. This is partly an explainability problem. The bigger practical problem is explaining it to the person in the organisation who understands front-desk operations. You would not ask the sales team to become the engineering team before they could tell you that a customer received the wrong promise.\nThat is why I called it an HR problem as well as a technical one. A trace can help an engineer find a failing step. The operator needs to recognise the business meaning: which policy supports the answer, what confused the system and where their correction belongs. A large log is not automatically that explanation. Nor is a model's fluent account of its own reasoning a verified report of what caused the answer.\nThe delivery example gives the operator a useful question. Did the system use an old address, misunderstand “last time” or promise something the carrier could not do? Those failures call for different improvements. The correction might change a source, add a check or preserve an unresolved carrier response. It need not begin with retraining the entire model.\nThe ambition was to isolate what was confusing the front desk, reinforce useful behaviour and correct the failure without losing your hair or waiting for hell to freeze over. That also gives a better answer to “What exactly do we want to control?” Following a disputed answer through its work makes the distinction concrete; choosing an improved version gives the correction somewhere to go.\nThe 8086 era, waiting for the Pentiums\nThe computer analogy extends to efficiency. There was a time when kilobytes of memory were an extraordinary constraint. The software we can afford to run changed as the machines and the methods improved. I expected AI to go through a similarly consequential expansion.\nMy 2024 illustration was deliberately large: a thousandfold efficiency improvement could, under a simple proportional model, pay for a model a hundred times larger while using a tenth of the compute. The arithmetic is 100 / 1,000 = 0.1.\nNote\nThe illustration's assumption. Cost scales directly with model size in this calculation. Actual training and serving costs depend on much more than parameter count.\nI expected larger models to bring stronger reasoning and other useful capabilities. Scaling research supplied reasons to take increases in model size, data and compute seriously, but it did not promise that every desired capability would appear at a particular size. It also made clear that the allocation among those inputs matters. Bigger and more efficient need not be opposing directions; neither makes control and explanation optional.\nThat capability gain would become useful to businesses if controllability and transparency improved alongside it. Otherwise we would have a more capable front desk whose work we still could not reliably supervise.\nYour back office has to teach the front desk\nEvery time the organisation fails to teach the front desk what it has learned, useful domain knowledge stays out of the system representing it.\nThe people handling customers know why the ordinary procedure sometimes fails. They know which exception the manual misses and why a technically correct answer may be useless in practice. The front desk needs a way to receive that knowledge and use it in the next interaction.\nThis is why the workflows inside the organisation have to become AI-first before the whole business can. That means reorganising the work so a system can participate between the input and the person who refines its output. The back office gains a useful tool while teaching the eventual customer-facing front desk.\nYojnAI approached that through agents and checked playbooks, with intermediate work, traces and feedback. The useful loop was more than collecting a thumbs-down. A person had to be able to see a mistake, explain it and have the correction reach the relevant source or operation. The organisation around the application supplies much of what makes that contribution meaningful.\nSuppose local delivery restrictions keep invalidating the front desk's promises. Another preferred-answer example might hide the pattern. A maintained source of those restrictions, used at the right step, could change the work itself. The next customer then benefits from what the previous interaction taught the business.\nThat is how the front desk can become more than a retention engine. It can give the business a way to learn from its relationships and make more of them possible.\nWhat about the contracts?\nBelieve it or not, compliance is a bitch. Making the interface pleasant does not make the contracts go away.\nA business still needs to know which information may be used, what the service is permitted to promise, who can act for the customer and what the parties have actually agreed. Installing the model on a customer's infrastructure does not answer all of those questions. The data path may still involve hosted gateways, diagnostic records and feedback elsewhere.\nThese arrangements shape the product. A customer can ask for a delivery change without having granted permission to use the conversation for an unrelated purpose. A technically possible action can still sit outside the service the company agreed to provide. The front desk has to work within those relationships, rather than leave someone to discover them after it has made the promise.\nThe confidence to put it in front\nCreating a minimal front desk is easy compared with trusting it to represent the business. The five parts belong together: control over what it does, explanations the operator can use, affordable capability, learning from the organisation and agreements that support the actual operation.\nThe possibility is a business less dependent on somebody being at a particular desk at a particular hour, without losing the knowledge those people contribute. A customer gets a simpler entrance; the business gets a way to make its experience useful at a larger scale. That is the magic worth pursuing.\nHow soon do you want it? What would make you confident enough to get there? Television, radio and magazines took decades to acquire the forms we now carry in our pockets. At the time I wrote this, the conversational systems behind these front desks had only just become widely accessible. The analogy does not give us a timetable.\nI was the one on the roof, turning the antenna. The next change may reach us through a much less visible adjustment.\nObjects in the mirror are closer than they appear. ;)\nKaplan and colleagues' Scaling Laws for Neural Language Models examines language-model loss in relation to model size, data and training compute. Hoffmann and colleagues' Training Compute-Optimal Large Language Models studies how model size and training tokens should be balanced under a compute budget.\n","url":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/blog/follow-the-data/#article","identifier":"content:dao-studio-self-hosted-is-not-a-data-map","@type":"TechArticle","name":"Follow the data, not the deployment label","headline":"Follow the data, not the deployment label","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["self-hosted AI","local model","data path","hosted gateway","diagnostic traces","feedback records","leaving a provider"],"mainEntityOfPage":{"@id":"https://daostudio.in/blog/follow-the-data/","@type":"WebPage","name":"Follow the data, not the deployment label","url":"https://daostudio.in/blog/follow-the-data/"},"description":"A document can begin on the customer's machine while its request, trace and feedback continue through other services.","datePublished":{"@value":"2024-05-21","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"Follow the data, not the deployment label\nThe customer has installed the application on their own machine. They ask it a question about a document stored there, receive an answer and later send a correction. Where did the document go? Where is the correction now? If they stop the application, which parts of that exchange remain elsewhere?\nThe installation answers only part of those questions. It can keep retrieval close to the customer's records while sending prepared context to a provider's gateway, using another organisation's model and retaining a trace in a separate store. Those connections are the service the customer has chosen to depend on. Following them gives “self-hosted” a more useful meaning than either a promise that everything stayed local or a reason to discount the control the local component really provides.\nYojnAI's operating model makes this distinction concrete. Customer-side instances and databases were intended to connect to services and caches hosted by DAO Studio. Create, Deploy, Improve and Comply described different responsibilities: configure the composition, serve its requests, prepare improvements from feedback, and govern access or personal-information exchange. Their relationship determined the application the customer would actually operate.\nA local model is one part of the system\nIn YojnAI’s pilots in investment banking, operations and the CFO office, I adapted a 4-bit Mistral 7B model through reinforcement learning from human feedback: MMLU comparable to GPT-3.5, BigBench above 70%, and self-hosting at about $1.75 an hour. Those are the results I reported at the time. The hourly figure is not the cost of delivering and supporting the whole application.\nThe February 2024 operating design made the split explicit. The customer’s infrastructure held the application, integration, model instances and trace, user and document databases. YOJN hosted gateways, microservices and stores for configuration, feedback and metrics. Installing the model beside the customer’s documents therefore left other parts of the operation crossing that boundary. A self-hosted model and a wholly local service were different arrangements in the studio’s own design.\nWhere each thing goes\nFollowing that exchange means distinguishing the source document from the context prepared for a model, and both from the execution record. The source can remain in the customer's system while a selected passage travels in a request. The trace might retain the passage, a source identifier or only the result; each choice changes what can later be investigated and what information remains outside the customer's machine. Feedback then creates another record with its own destination and use. One exchange has produced several continuing relationships, even if the customer saw a single answer.\nAn illustrative hybrid deployment makes the questions easier to locate.\nObject\tExample path\tWhat the customer needs to know\t\nSource document\tCustomer store → customer-side retrieval\tWhich component can read the original?\t\nPrepared context\tRetrieval → hosted gateway → selected model provider\tWhich passages leave the local environment?\t\nModel result\tProvider → application\tWhere is it retained and attached to the request?\t\nDiagnostic trace\tSelected steps → diagnostic store\tDoes it contain passages, identifiers or only operational metadata?\t\nReviewer correction\tReview screen → feedback project\tWhich application and permitted improvement purpose does it serve?\t\nMoving the model changes one row of this map; it does not automatically move the diagnostic or feedback stores. A box labelled “cloud” or “on-premise” is too broad to show the customer which dependencies remain. Each transfer and continuing record needs its own destination and purpose.\nCreation, deployment, improvement and compliance are separate jobs\nCreation is the work of preparing the composition and its connections. Deployment makes a selected arrangement available for requests. Improvement examines feedback and prepares changes. Compliance concerns the conditions under which information and access are handled.\nThose roles can be served through different components and by different people. In YojnAI’s operating design, creation began as consulting and deployment as installation services; broader self-service was a proposed extension. A configuration screen did not remove the work of understanding the source or adapting the workflow, and a local deployment could still depend on the provider's improvement process. The customer's own people also need a way to keep their knowledge current and correct a mismatch in use. Describing that continuing relationship gives the customer a more useful choice than treating the location of installation as a promise of independence.\nWho runs it, and who owns it\nA customer can administer infrastructure while the application includes platform code, a partner-owned configuration and a third-party model. The ability to stop a process or copy a file concerns technical control; the rights in those components follow their own arrangements. Receiving a trace similarly gives the provider information without making its contents unrestricted platform material.\nDAO Studio's platform and partner-product distinction made this an actual commercial boundary. The platform could be reused while the partner's application and records remained with their owner. Keeping that distinction through the deployment arrangement makes both kinds of control intelligible: who can operate the system and which components or records each party may use for another purpose.\nDiagnostics is a use, not merely a by-product\nAn execution record can help diagnose a failure, understand cost or improve the platform, while containing information the customer never intended to contribute to a general training corpus. Retaining it therefore creates a relationship around its use, not merely a technical by-product of serving the request. The customer needs to understand which diagnostic information the provider requires, why it is retained and whether improvement means repairing this application or using the material elsewhere. Those questions make the agreed purpose specific enough to shape the handling path.\nYojnAI's terms distinguished consent-bound diagnostic and improvement use. That agreement and its technical enforcement have different roles: the agreement defines the permitted purpose, while the actual handling path must implement it. A diagnostic record can help a provider repair the application without becoming unrestricted material for another use. The customer needs a way to understand that purpose and exercise the control the arrangement promises.\nThe exit is part of the choice\nA customer deciding to depend on a system needs an account of what happens if the relationship changes. Retaining the configuration, exporting records, replacing a hosted gateway and restoring an earlier version each depend on a different part of the arrangement. Model and tool licences may constrain the next environment even when the customer holds a local copy. Recovery requires the selected version, its dependencies and the customer's own state to fit together; an installer completing successfully establishes only one part of that work.\nA provider may offer something the customer reasonably wants to depend on. A hosted service can make the operation easier to maintain, while a local component gives the customer control over another part. The meaningful promise is an arrangement they can understand, operate and leave on known terms. Deployment location contributes to that choice alongside the purpose of transfers, the rights in the components and a workable exit.\n","url":"https://daostudio.in/blog/follow-the-data/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/blog/the-organisation-around-the-ai/#article","identifier":"content:dao-studio-the-organisation-around-the-ai","@type":"Article","name":"The organisation around the AI","headline":"The organisation around the AI","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["AI for small businesses","AI adoption","booking assistant","assisted intake","staff handoffs","organisational knowledge"],"mainEntityOfPage":{"@id":"https://daostudio.in/blog/the-organisation-around-the-ai/","@type":"WebPage","name":"The organisation around the AI","url":"https://daostudio.in/blog/the-organisation-around-the-ai/"},"description":"How a business turns its interest in AI into a task its people can use, maintain and improve.","datePublished":{"@value":"2024-03-04","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"The organisation around the AI\nA business can be enthusiastic about AI and still have no settled task for it. “Help us answer customers” sounds specific until a customer asks for a promise the business has never defined. The software needs information, but the missing thing may be an agreement among the people who will use it. A model can make that absence visible. It cannot decide on the business's behalf what the agreement ought to be.\nDAO Studio's ambition to make intelligence more accessible included small businesses whose knowledge did not necessarily live in a tidy system. A shopkeeper might hold the important distinctions in conversation, memory and practice. Making that knowledge usable by an application is partly a technical task and partly a relationship with the people who know why the work happens as it does. A simpler interface should bring them closer to that work, with assisted setup, a place to supply context and a correction that reaches the application. Making AI accessible included giving those people a practical contribution, rather than asking them to become software specialists first.\nThe tier-2 and tier-3 business context mattered to that ambition. An application designed around a dedicated administrator can ask a small business to create a job it cannot sustain. The person updating a service rule may also be serving customers and arranging tomorrow's work. A first application has to fit that day. Assisted setup, familiar examples and a short correction path may matter more than exposing every configurable feature on the first screen.\nThe studio’s early work considered small businesses and women in tier-2 and tier-3 India. It connected convenience and interoperability with consent, trust and the burden of maintaining configuration. It also recognised an adoption problem: contributors wanted a useful network, while a useful network needed people willing to join.\nA repair shop asks for a booking assistant\nImagine a repair shop that wants an assistant to answer messages and arrange appointments. The opening task seems straightforward: identify the appliance, collect the address and offer a slot. Then a customer asks whether a particular repair will be covered, whether a substitute part is acceptable and whether the quoted price is final. The shop has several informal ways of handling those questions, depending on who is working and what is found on inspection.\nAn assistant could retrieve the address successfully and still make the appointment worse by giving a firm answer where the shop needs an inspection. It could also refuse every useful question, leaving the staff to repeat the whole conversation. The boundary lies in the work itself: which information can be collected, which statements can be supported now and which decisions become possible only after someone examines the appliance. The business needs a way for the conversation to reach that next stage without losing what has already been learned.\nThis does not require a comprehensive process manual before any experiment begins. The shop could start with intake: collect the details a technician needs and prepare a concise request for confirmation. That narrow task reveals what is missing in actual use. Staff may discover that they repeatedly need a photograph of a label, that two service areas have different travel arrangements or that the same word means different faults to different customers. Each discovery can refine the intake rather than turn into another ad hoc correction after a promise has already been sent.\nTip\nTry the handoff with people first. Before handing intake to an assistant, the shop can try the sequence with its own staff. The person taking the request collects the appliance model, fault description and address, asks for a label photograph when the model is unclear, then passes that account to the person arranging the visit. The technician can reserve the diagnosis for inspection without making the initial conversation useless. A completed intake is something the next person can continue from, not merely a conversation that has ended.\nWillingness to try a tool is different from having the surrounding work ready for it. Readiness belongs to the task and the people carrying it. A business may be ready for assisted intake while remaining unready for automated diagnosis or price commitments. Labelling the whole organisation mature or immature obscures the starting point.\nThe knowledge needs a continuing home\nThe shop's opening information can come from records, staff conversations and examples of past work. Those sources serve different purposes. A completed invoice can show what happened in one case without becoming the price rule for every future case. A technician's explanation can reveal an important exception without necessarily being the shop's agreed policy. The application needs the distinctions that let it use the information appropriately, not simply a larger pile of text.\nOnce that information is usable, somebody still has to keep it current. Service areas change. Staff availability changes. A supplier stops carrying a part. A correction in one conversation needs to reach the applicable knowledge or procedure if it is to help the next customer. Otherwise the assistant can sound increasingly experienced while repeating an obsolete promise. Maintenance is part of making the capability accessible: the people closest to the work need a practical way to notice and repair a mismatch.\nSuppose the label photograph repeatedly arrives after the technician has already called the customer back. Staff can change the intake to request it earlier for the affected appliance types. Trying the revised sequence shows whether the extra request saves a call or simply adds friction for customers whose model was already clear. When an assistant takes over that step, the changed rule, its examples and the way staff correct a bad request need to travel together. The useful improvement is less reconstruction at the handoff; a larger number of automatically answered messages would not establish it.\nThis maintenance has an organisational shape: who knows the rule, who can change it and who notices when the application stops matching the work? The voluntary 2023 NIST AI Risk Management Framework 1.0 treats defined tasks, roles and ongoing monitoring as part of understanding AI use. In the shop, those questions are ordinary operating questions. A good model evaluation cannot tell us whether a changed service area will reach the assistant before the next booking.\nLearning to use the capability\nThere is a distribution problem here as well as an interface problem. The people who could benefit may not be looking for an agent platform. They may be looking for fewer unanswered enquiries or less time spent assembling the same information. A demonstration needs to meet that recognised problem, with somebody able to help translate the local practice into the application. The investment is wasted if every improvement still has to pass through that specialist forever.\nA configured application and a self-service product make different demands on their users. In the first arrangement, a delivery team can help translate the business's practice into the system and carry some of the setup work. In the second, the product needs to make more of that translation possible without the team standing beside it. Hiding configuration fields does not remove the decisions behind them; it changes how those decisions have to be explained and supported.\nThis is where community and learning can have a substantive role. People need examples that help them recognise a suitable task, understand a result and correct the knowledge the application relies on. They also need to be able to stop a poorly fitted use without feeling that they have failed to be modern. The aim is a capability they can own in practice, not a permanent dependence on a specialist who alone understands what the system is doing.\nThe measures should follow that aim. A hundred conversations may be valuable or may be a hundred unfinished requests. The shop can examine whether intake arrives complete, how much correction the staff must do, whether customers receive supportable commitments and whether the resulting appointment can actually proceed. These observations make the trial useful even if the conclusion is to narrow the task, change the process or leave a particular judgment with the technician.\nThe repair shop can make its conversational entrance useful by letting the intake develop alongside its own work. The technician receives enough context to continue, the customer gets commitments the shop can support and a correction has somewhere to go. YojnAI approached the application through capabilities and playbooks; the organisation supplies much of what gives that composition meaning. Making AI more accessible includes making this relationship workable: a useful task, understandable output, a place for exceptions and people able to improve the arrangement as they learn.\n","url":"https://daostudio.in/blog/the-organisation-around-the-ai/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"mentions":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/#article","identifier":"content:dao-studio-service-to-reusable-capability","@type":"Article","name":"Turning service work into reusable capability","headline":"Turning service work into reusable capability","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["service to product","Startup-as-a-Service","reusable capability","customer-specific configuration","product handover","product budget"],"mainEntityOfPage":{"@id":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/","@type":"WebPage","name":"Turning service work into reusable capability","url":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/","relatedLink":["https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/","https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/"]},"description":"The second customer's similar request reveals which part of a service can become a product.","datePublished":{"@value":"2024-06-18","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"Turning service work into reusable capability\nSuppose the second customer asks for a report that sounds almost exactly like the one a team finished last month. The task looks familiar until the documents arrive: the columns differ, the approval comes from another person and a familiar category means something else. How much of last month's work has the team actually saved?\nThat question sat inside DAO Studio's service-to-product ambition. Consulting put the team close enough to an organisation to understand a useful problem. A product would let that work accumulate: a configurable application, a reusable mechanism and a handover through which the next team could use and improve it. The next customer would receive more than another round of custom development. The interesting part was finding what could remain stable as the organisation around it changed.\nThe studio’s earlier proposition\nThe 2022 Startup-as-a-Service proposal joined venture setup to shared delivery. DAO Studio would lead a group supplying strategy, design, engineering, quality assurance and operations. A discounted development fee paid ahead of each phase was paired with a proposed share of future revenue. The product was to reach its first market entry and a handover, then remain listed as a utility under defined platform terms, including an initial exclusive period and a cap on revenue sharing.\nThat made two different bets. Hands-on work would help a venture reach something useful; a platform listing would give the resulting utility a route beyond the original engagement. The question underneath them still stands: can the reusable part earn its upkeep after the people who created it hand the work over?\nA creative and design partnership and a consumer-app prototyping proposal explored different sides of that arrangement. Neither made every partner’s product a studio-owned asset. The intended right to turn the work into a template needed to stay distinct from ownership of the customer’s product and from the actual rights agreed for a particular engagement.\nTwo reports that only look alike\nImagine a team building a weekly purchasing report for a small business. It brings together invoice data, checks missing fields and prepares a manager's summary. Another business asks for something similar. The extraction routine may travel, while supplier records, approval rules and explanations of unusual transactions remain with the first business. The new customer uses another source format, defines a purchasing category differently and has a different approver. The product question is now precise: which mechanism can remain stable across those changes?\nThe two reports give us a way to examine the resemblance. Perhaps both need to identify a supplier and retain where an amount came from, while only the first uses a particular approval threshold. The common work can become a unit worth maintaining. The threshold remains an explanation of one customer's operation. Copying the whole solution would carry both together; rebuilding everything would throw away the discovery. A product begins to take shape when the team can make that difference usable by somebody else.\nFinding the stable part\nA reusable unit exposes what it needs and what it produces. In the reporting example, that could mean an explicit input format, a rule for representing missing values and an output that retains the relevant source locations. Those stable choices leave customer-specific policies as configuration with a named owner. A different approver can use the same extraction mechanism without changing every customer's approval rule. A new source format gives the adapter work to do rather than silently losing fields until the data fits.\nThe boundary could be made explicit:\nShared mechanism\tCustomer-specific setting\t\nReturn an amount with currency and source location\tWhich purchasing category it belongs to\t\nRepresent an absent value as unresolved\tWho must supply or review that value\t\nDetect an unsupported input format\tWhich source systems this customer connects\t\nProduce a versioned extraction result\tWhich manager may accept the report\t\nThe second customer can change the right-hand column without redefining the extraction result for everyone. An unsupported document still needs a recognisable failure path rather than an empty report that looks like no purchases occurred. A version, known dependencies and the conditions under which the capability was evaluated give the next team somewhere to begin investigating it.\nGeneralisation does not supply permission\nCaution\nRemoving a name does not establish reuse rights. An artefact called a template may still contain a customer's confidential process, licensed material or distinctive configuration after their name is removed. The arrangement needs to distinguish the shared platform, the customer's deliverable, their data and any permitted reuse. A reusable input convention can belong to the platform while a particular mapping expresses the customer's process. The actual rights and agreement determine whether either can travel to another use.\nDAO Studio explored templatising service work, while YojnAI distinguished the shared platform from a partner's product. That distinction gives reuse a concrete form: the platform can develop while the partner keeps the work and records belonging to their application. Other cases may require independent implementation, an approved abstraction or an explicit licence. Sometimes a lesson informs the next design while the original artefact stays with its owner.\nA handover is part of the product decision\nConsulting can rely on a person who remembers the exceptions. A product has to make more of that knowledge available to the next team. For the report, a handover would explain how to connect the sources, change the permitted configuration, review an uncertain result and recover a failed run. It would also identify the responsibilities that stay with the provider and those the customer's team accepts. These choices give the shared units a particular operating context.\nAn easy setup screen can conceal configuration upkeep, evaluation and repair that somebody still has to perform. Without an intelligible handover, a supposedly self-service product may simply move that work into an invisible support queue. Its value depends on another team being able to operate the capability within understood limits, including the ordinary exceptions through which the report becomes useful to them.\nThe first adoption and the wider network\nDAO Studio also explored DAOnet, a network through which people could discover and compose capabilities. That introduced a circular adoption problem: contributors want demand, while users want capabilities they can already rely on. A service for one customer can reveal the first need, and a working reusable unit can make the next adoption easier. The reporting tool can deliver value to one business before hundreds of others join.\nA network could then improve discovery and coordination around that contribution. Its terms would need to make joining useful to the business: obtaining an ordinary report should not depend on surrendering its private process or participating in an unrelated token system. The capability's value gives the network something to connect; the network's value comes from making that connection easier.\nSupport can consume the product budget\nService income was one proposed source of support for product development and research; the studio’s earlier plan also depended on raising capital. They were not interchangeable sources of money. Service income first had to cover delivery and the continuing work needed to support the customer. Delivery has to leave enough capacity for product development to happen rather than consume it through unfinished support.\nA low installation cost says little if every new configuration creates hours of unpriced work. Subscription and conversion forecasts can help plan the operation, but their usefulness depends on demand and costs becoming observable as the service develops. The reusable mechanism should reduce reconstruction across customers; otherwise the product budget may only be subsidising repeated custom delivery.\nConsider a deliberately simple monthly budget. A service brings in 100 units of revenue. Delivery uses 60, continuing support uses 15 and the common operating costs use 10. That leaves 15 for product work or a reserve. If exceptional requests lift support to 30, the whole 15 has gone before anyone improves the shared mechanism. Calling part of the income a product budget does not create the time to spend it.\nReuse has an economic effect when it changes that arrangement. A clearer setup path might reduce the next customer's delivery effort; a fix to a common mechanism might reduce support across existing customers. Both can release capacity for another improvement. But generalising a capability also creates its own testing, documentation and compatibility work. The relevant comparison includes that upkeep. The product is becoming more sustainable when the shared work costs less than the reconstruction it prevents, without leaving the customer's exceptions unpaid and unattended.\nThis is why a second adoption matters more than a reusable-looking codebase. It exposes what travels, what has to be configured and what still depends on the original team. Service income can finance discovery; the resulting product has to earn its continuing maintenance through adoption. Research retains a different freedom: it can pursue an important possibility before there is a customer ready to pay for it, provided the studio can afford that time.\n","url":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"mentions":[{"@id":"https://daostudio.in/daonet/#entity","identifier":"project:daonet","@type":"CreativeWork","name":"DAOnet","subjectOf":[{"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","url":"https://daostudio.in/daonet/"},{"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/"},{"@id":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","@type":"CollectionPage","name":"DAOnet mentions","url":"https://daostudio.in/daonet/mentions/"}]},{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/","identifier":"content:dao-studio-collections","@type":"CollectionPage","name":"Thoughts","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"mainEntity":{"@type":"ItemList","numberOfItems":3,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/","@type":"CollectionPage","url":"https://daostudio.in/collections/coordinating-emergencies/","identifier":"collection:dao-studio-coordinating-emergencies","name":"Coordinating emergencies"}},{"@type":"ListItem","position":2,"item":{"@id":"https://daostudio.in/collections/composing-ai-work/","@type":"CollectionPage","url":"https://daostudio.in/collections/composing-ai-work/","identifier":"collection:dao-studio-composing-ai-work","name":"Composing AI work"}},{"@type":"ListItem","position":3,"item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/","@type":"CollectionPage","url":"https://daostudio.in/collections/protocols-and-reuse/","identifier":"collection:dao-studio-protocols-and-reuse","name":"Protocols and reuse"}}]},"description":"Three inquiries from the studio's products: how an incident is carried from request to response, how people join an application while it is working and what a capability must preserve to serve another team. Standalone essays are on the Blog.","text":"","url":"https://daostudio.in/collections/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/composing-ai-work/","identifier":"collection:dao-studio-composing-ai-work","@type":"CollectionPage","name":"Composing AI work","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"The context, traces, feedback and versions around a model-driven application.","text":"An application can be useful before it has a final answer. Someone can review the terms already extracted from an agreement while another person supplies the date still missing from a purchase. Work has begun, and people have something meaningful to contribute. Waiting for one finished response would hide that opportunity.\nYojnAI brings this question into a platform for composing, deploying, inspecting and improving AI applications. It reached pilots in investment banking, operations and the CFO office; its wider ambition is to make this developing work available to the people and systems around it. The interesting unit is not merely a model capable of answering. It is a contribution another person or component could use, question and change without losing the rest of the operation. That asks for a place to enter, an account of what has already happened and a way to see which later work depends on a correction.\nThere is a tension here. Structure can make a correction precise, but too much structure can make every exception a programming task. A business operator needs to be able to say why a proposed answer does not fit their work; an engineer needs enough of the path to investigate it. A natural conversation can invite that contribution while a more explicit account keeps it consequential after the conversation ends. Neither can do the other's whole job.\nThe ambition is an application people can help become better through ordinary use. A correction should reach its source or mechanism, a useful improvement should survive the next request, and the business should be able to recognise what changed. Making that possible is part of the application itself, not a separate appeal for feedback after it has finished working.\n","url":"https://daostudio.in/collections/composing-ai-work/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"hasPart":[{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/","identifier":"journey:dao-studio-composition-to-deliberate-change","@type":"CollectionPage","name":"From composition to a deliberate change","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/","identifier":"journey:dao-studio-composition-to-deliberate-change","@type":"CollectionPage","name":"From composition to a deliberate change","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Composing AI work","item":{"@id":"https://daostudio.in/collections/composing-ai-work/"}},{"@type":"ListItem","position":2,"name":"From composition to a deliberate change","item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/"}}]}],"description":"Application units, the execution record and a version change chosen on purpose.","text":"A purchasing assistant has extracted an agreement's payment terms and is waiting for a delivery date. Someone can supply the date, and a reviewer can check the terms, before the rest of the work continues. YojnAI's composition model gives that contribution a place: an intermediate result, a check and an application that can resume when the missing context arrives. The guide to the purchase request sets out the example; the first article here develops it.\nSuppose the completed report is still wrong, because the reviewer disputes a payment term. The composition identifies work we can investigate; its execution record helps follow what happened. A faulty extraction, a bad lookup and a correction lost later point towards different remedies. The investigation can now choose a part to change rather than begin again from the final answer.\nThe remedy encounters the rest of the application. A changed lookup may solve this case while confusing another supplier. The team needs to bring both cases to the candidate, see which part improved and decide whether the trade-off fits the operation. The next version then carries a particular choice: a changed source-selection rule, for example, with evidence for retaining it. The purchase gives somebody a place to contribute; investigating that contribution gives the application a way to improve beyond this one purchase.\n","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/composing-ai-work/","identifier":"collection:dao-studio-composing-ai-work","@type":"CollectionPage","name":"Composing AI work","url":"https://daostudio.in/collections/composing-ai-work/"}],"mainEntity":{"@type":"ItemList","numberOfItems":3,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/#article","identifier":"content:dao-studio-agent-playbook-and-application","@type":"TechArticle","name":"An agent, a playbook and an application","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/"}},{"@type":"ListItem","position":2,"item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/reading-the-work-behind-an-answer/#article","identifier":"content:dao-studio-a-trace-is-not-an-explanation","@type":"TechArticle","name":"Reading the work behind an answer","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/reading-the-work-behind-an-answer/"}},{"@type":"ListItem","position":3,"item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/#article","identifier":"content:dao-studio-feedback-is-not-a-deployment-instruction","@type":"Article","name":"From feedback to a version worth using","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/"}}]}},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/#article","identifier":"content:dao-studio-agent-playbook-and-application","@type":"TechArticle","name":"An agent, a playbook and an application","headline":"An agent, a playbook and an application","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["agent composition","checked playbooks","intermediate state","agent callbacks","application versions"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/","@type":"WebPage","name":"An agent, a playbook and an application","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":3,"itemListElement":[{"@type":"ListItem","position":1,"name":"Composing AI work","item":{"@id":"https://daostudio.in/collections/composing-ai-work/"}},{"@type":"ListItem","position":2,"name":"From composition to a deliberate change","item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/"}},{"@type":"ListItem","position":3,"name":"An agent, a playbook and an application","item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/"}}]}]},"description":"A pending purchase shows how agents, checked playbooks and application state let other people and systems join the work.","datePublished":{"@value":"2024-05-06","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"An agent, a playbook and an application\nA final answer is a convenient interface until another part of the system needs to participate in reaching it. A purchasing assistant may have found the agreement and extracted its terms while still waiting for a delivery date. The reviewer can already do useful work with those terms; the customer's answer should enter at the point where it is needed. Making both people wait for a completed response wastes the structure the application has already built.\nYojnAI’s composition model gives that unfinished work a form other people and systems can use. An agent makes a contribution, a playbook arranges the contributions, and an application connects them to a customer's records, services and access. Each has a different job to do.\nContext: the organisation’s records, services, people and permitted access.\nApplication: a particular configuration of playbooks and their connections. Versions can change the configuration’s behaviour without becoming separate service instances.\nPlaybook: agents arranged with checks, dependencies and conditions for continuing.\nAgent: models and tools combined for one contribution, with intermediate state available to the surrounding work.\nThe space between a call and an entire system\nCalling a model gives the surrounding application responsibility for arranging the work. Calling an entire orchestrated service gives it a finished response. Between those two lies a place to integrate: the work in progress, with enough identity and meaning for another component to contribute to it.\nThink of a hypothetical assistant preparing a purchase request. It retrieves a supplier record, extracts terms, identifies a missing delivery date and asks for clarification. A second system may need to display the missing date before the final request exists. A reviewer may need to inspect the extracted terms without rerunning everything.\nAn agent-level callback can make the extracted terms available while the purchase is pending. Saved intermediate state keeps that extraction available when the customer supplies the date. The application can continue from the missing answer instead of repeating unrelated work. What crosses the interface is a particular operation, its available results and the dependencies still waiting to be satisfied.\nWhat the agent takes on, and what it leaves alone\nAn agent combines models and tools into a unit of application work. The extraction agent needs a source, a way to identify its terms and a form in which to return them. A model can contribute interpretation while retrieval or a deterministic parser supplies another part. The contribution belongs to the whole unit, rather than being another name for the underlying model.\nIts output also shapes the next contribution. Returning a guessed delivery date makes the composition appear complete while moving missing information out of view. Returning it as unresolved gives the application a question to ask. Another workflow can reuse that extraction without inheriting the entire purchasing operation, including the authority to place an order. The unit becomes composable because its contribution and limits remain intelligible.\nThe playbook carries the arrangement\nA playbook arranges agents and checks into a workflow. In the purchasing example, the supplier identity may need to agree across two records, a term may need its source location and a missing value may call for clarification. The draft can proceed when those dependencies are satisfied, then meet a review before leaving the system. The arrangement gives each contribution a reason and a place in the work.\nA failed check consequently carries information about what to do next. A missing source location can send the work back to extraction; disagreeing identifiers can prompt investigation of the records; an unresolved intention can require the customer. These checks establish different things. A field's presence or two identifiers agreeing helps the workflow without settling whether this is the supplier the customer intended. Preserving the distinction makes the failure useful instead of reducing it to “the model failed.” The execution record can help locate which contribution needs attention.\nA financial calculation makes the need for structure especially clear. To calculate the last twelve months, combine the previous financial year with the current partial-year period, then subtract the corresponding prior-year period. Each input needs its period and units: a correct subtraction applied to mismatched periods is still the wrong answer. Named inputs, operations and conditional branches make those choices inspectable.\nBasic and diluted shares are different quantities, as are equity value and enterprise value. Price dates, share-count dates and statement dates can also differ. Keeping each definition with its source, period and units prevents the workflow from quietly substituting a different calculation for the one requested.\nThese intermediate contributions are also places where another application can join the work. Some things never change develops that callback-and-cache argument beyond the individual calculation.\nWhat changes when the customer answers\nThe moment the user answers the missing-date question, the application has acquired context that did not exist at the first call. That answer belongs to a particular purchase and version of the work. It can unblock the draft without changing the supplier extraction. If the reviewer instead corrects a payment term, the dependent draft needs reconsideration while an unrelated delivery address can remain valid. State becomes useful when the application can distinguish these effects rather than stuffing every change into a larger prompt and hoping it is interpreted correctly.\nThe following invented state account makes the dependency concrete.\nContribution\tAfter extraction\tAfter the customer supplies a date\tAfter the reviewer corrects the payment term\t\nSupplier and source\tAvailable\tRetained\tRetained if the same source still applies\t\nPayment term\tAvailable, awaiting review\tRetained\tReplaced by the reviewed value\t\nDelivery date\tUnresolved\tAvailable\tRetained\t\nPurchase draft\tWaiting for the date\tReady to assemble\tRecompute the part depending on the term\t\nOrder placement\tNot performed\tNot performed\tNot performed\t\nSupplying the date can complete a draft without placing an order. Correcting the payment term can invalidate part of that draft without discarding the address or asking for the date again. A delayed callback carrying the earlier term has to remain an earlier result, rather than overwrite the correction. This is the practical attraction of exposing the work's dependencies: resumption can continue at the change instead of restarting the conversation or replaying a consequence.\nThe dependency account also has to survive concurrent work. A request sent before a correction can return after it. The application needs to compare the returning result with the source and operation revision it was asked to use; arrival time alone cannot supply that relationship. Retaining the late response can make the execution explainable without accepting it into the current draft. The draft, its dependencies and any external action need distinguishable records.\nThe application ties the playbook to one customer's records\nAn app configuration connects playbooks to the records and services they need. The same playbook can enter another context, where different supplier records are connected, different people may inspect them and an approved request goes to another destination. Those choices make it a particular customer's application: they affect the actual work, not merely its branding.\nAn application configuration can have several versions, which count as one service instance. Revising an agent or check changes the composition without making it a separate instance. The distinction lets the application develop without treating every adjustment as a new commercial identity. Its versions nevertheless need to identify the behaviour and dependencies the customer is choosing to use. Those same conditions matter when a capability travels to another team: the contribution has to remain intelligible outside its first application.\nWhere another contribution can join the purchase\nThe purchase can now continue through a useful division of work. The extraction supplies terms with their source; the customer supplies a date; the reviewer corrects a value; the playbook assembles the dependent draft. The application makes those contributions part of one operation without treating them as one undifferentiated prompt. A change has somewhere to enter, and the work it affects has somewhere to continue.\nThe larger question of whether learned capacities themselves can be composed remains compelling. Here the useful unit is more immediate: a contribution whose meaning and dependencies let another person or system join the work before the final answer exists.\n","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/","identifier":"journey:dao-studio-composition-to-deliberate-change","@type":"CollectionPage","name":"From composition to a deliberate change","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/#article","identifier":"content:dao-studio-feedback-is-not-a-deployment-instruction","@type":"Article","name":"From feedback to a version worth using","headline":"From feedback to a version worth using","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["improving an AI application","feedback projects","expertise weighting","candidate versions","fine-tuning"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/","@type":"WebPage","name":"From feedback to a version worth using","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":3,"itemListElement":[{"@type":"ListItem","position":1,"name":"Composing AI work","item":{"@id":"https://daostudio.in/collections/composing-ai-work/"}},{"@type":"ListItem","position":2,"name":"From composition to a deliberate change","item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/"}},{"@type":"ListItem","position":3,"name":"From feedback to a version worth using","item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/"}}]}]},"description":"A disputed supplier term follows different routes to improvement, from source correction to a compared application version.","datePublished":{"@value":"2024-05-13","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"From feedback to a version worth using\nThe supplier allows fourteen days, says the reviewer, not the thirty days returned by the purchasing assistant. The team could add the correction to its examples and train again. But suppose the answer faithfully followed the previous agreement. Teaching the model another sentence leaves the obsolete source in place, ready to produce the next disagreement.\nThe objection opens a choice about what to improve. A source, a step, an explanation and the task itself can each need attention. YojnAI’s improvement idea connected the person’s objection to that choice through feedback projects, candidate jobs and deliberately selected application versions. The intended result was a system that could become more useful through experience, with the team able to recognise which change it was choosing.\nWhat a reviewer's objection carries with it\nThe agreement's identity and version make the objection specific. The current document may resolve the immediate case, while the retrieval path needs a way to recognise which agreement applies next time. This is a different improvement from teaching the model to interpret an unfamiliar clause. Both can begin with the same negative rating; the context determines where that rating can become useful work.\nNow suppose the source is current but the explanation is so complicated that the user cannot tell what to do. Or the answer includes information the user should not see. These failures call for different interventions: clearer explanation in one case, a repaired access boundary in the other. Feedback becomes useful when it carries the question being judged, the run and configuration involved, and what the person expected instead. Those details help locate a relevant change rather than merely accumulate disapproval.\nDifferent reviewers contribute different things\nThe intended YojnAI designs separated access roles from expertise weighting and allowed app defaults and project-specific feedback settings to differ. The same execution could be evaluated for several purposes: a domain expert might judge an interpretation, an end user its usefulness, and another reviewer whether the operation was appropriate. Keeping their questions visible made room for disagreement that the product actually needed to address. A single combined score could hide that difference before anyone understood it.\nExpertise weighting also left release responsibility as a separate decision. The person best placed to identify an error need not be the person responsible for changing the customer's application. Their contribution can be valuable precisely because it informs someone else's choice. “Human in the loop” acquires a practical meaning when the system gives that contribution a question, a context and a route into the work.\nChange the part that caused the problem\nAn application can improve through a source correction, a revised tool, a new check, a prompt change, a workflow change or model adaptation. That range was part of the appeal of treating YojnAI as a composition. The team could examine which contribution carried the failure and change it, while retaining the other work that remained useful.\nSuppose extraction repeatedly misses a term across a supported document family. A different model or training approach may help. Suppose the term is extracted correctly but loses its source when passed to the next step. The interface between components may be the better place to change. Evidence of that route lets the team choose a relevant intervention instead of treating sophistication as a substitute for diagnosis.\nThe candidate meets more than its original failure\nA revised version should encounter the case that prompted the change, alongside other work the application still has to do. An improvement for one question can damage another: a new model can increase latency, a narrower source can omit a previously valid use and a more cautious workflow can make an ordinary task unnecessarily difficult. The comparison needs cases and meanings appropriate to that operation, rather than a score detached from it.\nFor the purchasing example, we can specify a small comparison before running it:\nCase\tWhat the comparison must examine\t\nOld and current agreements are both present\tSelect the applicable version and retain its identity\t\nA valid clause uses unfamiliar wording\tInterpret the term and retain the source location\t\nThe delivery date is missing\tAsk for it rather than invent it\t\nThe reviewer has already corrected a term\tPreserve the correction against an older callback\t\nNow imagine a source-selection change fixes the first case but drops the source location in the second. It has repaired the immediate complaint while making review harder. A larger model might resolve the unfamiliar wording but take longer on ordinary requests. Neither trade-off disappears inside an overall accuracy score. The team needs the case-level results and the operating consequence before choosing between them.\nYojnAI’s operating design made the path explicit: select an app and version, then a trace and the step being judged. Feedback belonged to a project; an administrator could version that project for fine-tuning, start an improvement job, inspect its result and explicitly push a chosen version to the app’s environment. One-click reversion was part of the same design. The comparison could therefore inform a particular choice, rather than make a negative rating an instruction to train or deploy.\nIn April 2024 the studio reported differential and cumulative fine-tuning as beta. A project’s access roles, its reviewers’ expertise weights and the person choosing a release still answer different questions.\nChoosing which version to release\nA candidate can be better in a test and still need a staged introduction or another review before release. Someone has to decide what the evidence warrants in the intended setting. Identifying the selected version and its purpose makes that decision usable: a change chosen to improve extraction is a particular commitment, not a permanent quality inherited by every later configuration.\nRecovery belongs to the same choice. If the new version changes a behaviour somebody relies on, the team needs to understand the difference and, where appropriate, return to an earlier arrangement with its dependencies intact. The sequence from objection to investigation, comparison and release makes learning useful to another person. They can understand which part changed, why it was chosen and what work the application should now do better.\n","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/","identifier":"journey:dao-studio-composition-to-deliberate-change","@type":"CollectionPage","name":"From composition to a deliberate change","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/reading-the-work-behind-an-answer/#article","identifier":"content:dao-studio-a-trace-is-not-an-explanation","@type":"TechArticle","name":"Reading the work behind an answer","headline":"Reading the work behind an answer","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["AI application traces","API-call logging","source selection","explanations for operators","feedback projects"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/reading-the-work-behind-an-answer/","@type":"WebPage","name":"Reading the work behind an answer","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/reading-the-work-behind-an-answer/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":3,"itemListElement":[{"@type":"ListItem","position":1,"name":"Composing AI work","item":{"@id":"https://daostudio.in/collections/composing-ai-work/"}},{"@type":"ListItem","position":2,"name":"From composition to a deliberate change","item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/"}},{"@type":"ListItem","position":3,"name":"Reading the work behind an answer","item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/reading-the-work-behind-an-answer/"}}]}]},"description":"Following a disputed payment term through retrieval, extraction and review turns a wrong answer into a useful investigation.","datePublished":{"@value":"2024-05-09","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"Reading the work behind an answer\nA purchasing assistant says the supplier allows payment after thirty days. The reviewer opens the agreement and cannot find the term. The answer is fluent and the disagreement is clear, but where should the investigation begin? Perhaps the assistant read another agreement. Perhaps it added a term to the right one. Perhaps the term was correct when retrieved and changed before it reached the reviewer. The final sentence gives each possibility the same appearance.\nYojnAI’s tracing and feedback tools were meant to help with this problem: the same wrong answer can require different repairs. We need to follow the agreement into the application, see which term was extracted and find out what reached the reviewer. Then the complaint can tell the team where to look.\nTwo runs that end in the same wrong answer\nTake two hypothetical runs. In the first, retrieval selects another agreement with a similar name and extraction accurately returns its term. Asking extraction to become more careful would address the wrong part of the work; the source selection needs attention. In another run, the right agreement reaches the model and the term appears only in generation. Now the investigation has a particular step to examine, including the input, instruction and returned value.\nPut the two paths beside the same final sentence:\nRecorded part of the work\tWrong source, faithful extraction\tRight source, unsupported extraction\t\nExpected agreement\tSupplier A, agreement v2\tSupplier A, agreement v2\t\nRetrieved agreement\tSupplier B, agreement v1\tSupplier A, agreement v2\t\nSource term\tThirty days\tFourteen days\t\nExtracted term\tThirty days\tThirty days\t\nFinal answer\tThirty days\tThirty days\t\nFirst investigation\tWhy did retrieval select B?\tWhy did extraction return a term absent from A v2?\t\nThe first path does not ask for a more faithful extraction; it asks for a different source selection. The second requires examining the extraction input and operation. If a third run records only the final sentence, neither investigation has that starting point. Logging becomes useful through the distinctions it preserves, not its volume.\nWhat a call log and a step trace each show\nYojnAI included API-call logging and records for steps within a run. An endpoint, time and response status describe the call; inputs, outputs and relationships between steps describe more of the composition. A processed request can still return a wrong answer, and a step tree shows only the events chosen for recording. A trace is a representation designed for particular questions, so its usefulness depends on what those questions require it to preserve.\nCaution\nLogs can expose more than the answer. What the record preserves shapes both the investigation and the exposure it creates. Omitting source identity can leave a reviewer unable to distinguish a correct extraction from the wrong agreement; retaining every input can preserve sensitive material the final answer never disclosed. The logging decision needs to follow the operation being investigated and the people who need to examine it. Enough context to locate the failure, with a defined purpose for retaining and accessing that context, is a more useful aim than treating the amount logged as a measure of diagnostic quality.\nYojnAI’s own logging shows why these levels must remain separate. A central logger recorded one row per API call, while a partner application’s trace service stored callbacks with run and parent-run identifiers, inputs, outputs and feedback. Those rows could preserve contributions without guaranteeing a valid execution tree or a history of successive assessments. They therefore answer the narrower question of what was recorded, not whether the whole explanation and improvement loop worked.\nThe finance-research designs exposed a different class of failure: a calculation could mix a price date with another period’s share count, confuse equity with enterprise value, or lose a qualifier such as stock-based compensation while copying a definition. A richer trace helps only if it retains the relevant definition and source. More events cannot repair a calculation whose terms already mean the wrong thing.\nOne explanation for the engineer, another for the operator\nAn engineer may need to inspect the step that transformed a value. A business operator may need to know why that value is appropriate for the customer's situation. Giving both the same raw log leaves the operator to reconstruct the business meaning, while giving both a fluent explanation can leave the engineer without the execution evidence. The presentation follows the question each person is trying to answer.\nA model's account of why it answered can be material to examine, but it is not a verified account of its internal process. A more modest explanation can be stronger: this statement comes from this source, this rule permits the proposed action, this assumption remains unresolved. It connects the result to something a person can assess without claiming access to every hidden computation. Showing the source excerpt, the tool response and the generated explanation distinctly lets the reader understand what each contributes.\nOne run can raise several questions\nYojnAI's intended feedback design allowed the same trace to be considered in more than one feedback project. Accuracy was one question; usefulness and appropriate disclosure were others. An answer could be correct and needlessly complicated, clear and unsuitable to disclose, or satisfactory to the immediate user while leaving the business task unfinished. Separate questions made those judgments actionable instead of compressing them into a rating whose meaning changed with each reviewer.\nThe reviewers also brought different kinds of knowledge and responsibility. Access to a feedback project did not establish expertise in a specialised result; expertise did not establish authority to change the customer's application. Identifying what each person was judging let the team use those contributions together. Disagreement could then point towards a real trade-off or a missing question, rather than become a contest over whose general score should prevail.\nWhat the investigation leads to\nAn investigation gives the record its practical value. It may show that retrieval needs a better source, that a model requires a different instruction or that the customer process leaves an exception undefined. Sometimes the available trace cannot distinguish those possibilities. Improving that record can then be the relevant change: the next run should preserve the evidence needed to resolve the question, rather than append a plausible explanation to the missing part.\nTracing, explanation and evaluation contribute different parts of the improvement. The trace locates the operation; interpretation makes its evidence meaningful; evaluation asks whether the result was acceptable. Together they can turn a complaint into a source correction, a changed component or a clearer business decision. The investigation gives the next version something specific to address, so the change can be examined for the work it actually improves.\n","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/reading-the-work-behind-an-answer/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/","identifier":"journey:dao-studio-composition-to-deliberate-change","@type":"CollectionPage","name":"From composition to a deliberate change","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/coordinating-emergencies/","identifier":"collection:dao-studio-coordinating-emergencies","@type":"CollectionPage","name":"Coordinating emergencies","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"The interface, evidence path, evaluation and continuing work behind an emergency response.","text":"Someone asks for help. The service receives the request, but a nearby contact is unavailable and the image sent to a reviewer is old. There is already something to handle. The next person needs a way to carry it without pretending that the missing part has been settled.\nYOJN Care brings that continuity into an emergency-response product for homes, shops and neighbourhoods, connecting personal SOS, monitored sites, human review and intended response. A deliberate request and a camera observation can begin different work. People need enough evidence to judge the situation, enough room to correct an interpretation and an intelligible commitment when the incident passes to somebody else. The incident keeps changing while those contributions travel.\nThe question is how the parts can support one another. A clearer view may save a reviewer from a repeated call. A preserved question may let the next shift continue rather than start again. Grouping observations may reduce duplicate work while keeping a meaningful change visible. The gains depend on a service able to receive them: somebody with time to review, equipment that continues to supply useful evidence and a response arrangement people can actually carry.\nThat makes the unfinished case important. It still holds a question, consumes some continuing capacity and may reveal where the service cannot proceed. Keeping it intelligible helps the operation improve. Making it disappear from the report helps only the report.\nOne way to read the essays is to follow a single incident. The evidence path asks what reaches the reviewer, An interface with room to act what people can do with it, and Who carries the incident? how the work passes between them. The cases that are still waiting asks what an unfinished case means for the results, and The cost of continuing response what keeping the service going takes.\n","url":"https://daostudio.in/collections/coordinating-emergencies/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"hasPart":[{"@id":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/#article","identifier":"content:dao-studio-an-interface-with-room-to-act","@type":"Article","name":"An interface with room to act","url":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/"},{"@id":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/#article","identifier":"content:dao-studio-detection-is-not-dispatch","@type":"Article","name":"Who carries the incident?","url":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/"},{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/#article","identifier":"content:dao-studio-pending-is-not-noise","@type":"Article","name":"The cases that are still waiting","url":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/"},{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/#article","identifier":"content:dao-studio-the-cost-of-continuing-response","@type":"Article","name":"The cost of continuing response","url":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/"},{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/#article","identifier":"content:dao-studio-the-evidence-path","@type":"TechArticle","name":"The evidence path","url":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/#article","identifier":"content:dao-studio-an-interface-with-room-to-act","@type":"Article","name":"An interface with room to act","headline":"An interface with room to act","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["emergency interaction design","one-handed use","request cancellation","accessible status messages","event priority"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/","@type":"WebPage","name":"An interface with room to act","url":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Coordinating emergencies","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/"}},{"@type":"ListItem","position":2,"name":"An interface with room to act","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/"}}]}]},"description":"How an emergency interface carries intention, uncertainty and changing commitments through a constrained moment.","datePublished":{"@value":"2024-07-15","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"An interface with room to act\nA person asking for help may have one hand free, little time and no interest in learning an application. The reviewer needs to understand what happened and what they can do next. Both depend on an interface that makes the action clear without promising more than has happened.\nYOJN Care connects one-handed SOS and High Alert actions with the people reviewing them. An SOS says somebody is asking for help; a camera alert supplies an observation to investigate. Neither tells the whole story, and an SOS can be activated accidentally. The interface has to carry that difference from the first gesture into the review.\nFrom the first gesture to what the service has received\nImagine a person opening an assistance interface with one hand while trying to leave an unfamiliar place. The immediate action should be easy to find and physically usable. If it sits behind several screens, the product is asking for attention the situation may not allow. Yet making it prominent does not settle when a gesture becomes a request, whether the person can correct it or what the service has actually received. Those questions belong together: speed of access is useful when the user can also understand the consequence.\nA button that activates on the first touch and one that activates when the finger is released leave different opportunities to recover from a mistaken gesture. W3C's pointer-cancellation criterion recognises this distinction for single-pointer web interaction, including completion on release, abort and undo. It does not prescribe a universal emergency gesture. The interaction still needs to be tested with its users and constraints. A long press, for example, may reduce some accidental touches while making the action harder for somebody who cannot maintain contact.\nThe request's progress needs equally careful language. A compact state account can guide the design:\nDisplayed state\tWhat has happened\tWhat it must not imply\t\nTrying to send\tThe local interface is attempting transmission\tThat the service received the request\t\nReceived\tThe service acknowledged the request\tThat a person accepted the response work\t\nReview accepted\tA reviewer accepted the relevant work\tThat assistance arrived\t\nWithdrawal requested\tA correction was submitted\tThat every earlier action has been reversed\t\nThese messages may arrive at different times. A spinning indicator that quietly becomes a reassuring tick can conceal the difference, particularly when the network drops after the initial action. The person needs to know what happened, rather than interpret the animation as a promise of assistance.\nThat feedback must reach people who do not see the screen in the same way. W3C's status-message guidance explains how qualifying web status updates can be exposed to assistive technology without moving focus. The broader design problem is continuity: a request should remain understandable through changes in attention, perception and connection. Announcing a state is useful only when the state itself has an honest meaning.\nWhat a label and a clock mean\nThe personal-request code defined PENDING, DELIVERED and READ notification labels, separately from an SOS’s START and STOP. Their implementation is a warning about names: the SOS save path wrote DELIVERED before attempting the push notification, and listing notifications changed their stored state to READ. The push result was recorded separately. Neither label proves that a person saw the request, accepted responsibility or dispatched help.\nThe personal-request labels and the monitoring design’s clocks answer different questions: what has been recorded, and how long the reviewer has to act. Operator pickup was due before 90 seconds and the work had to be closed before 105; the manager’s corresponding windows were 60 and 75 seconds. A missed operator response passed to the manager; a manager timeout passed to the community as suspicious. For media loading, the design allowed either delaying the timer’s start or adding the delay to its allowance. The table sets the labels and the clocks side by side; where the page’s controls are available, they work the delayed-start variant and show the delay.\nEvent\tStored label or design consequence\tWhat remains unknown\t\nNotification row saved, before push attempt\tDELIVERED\tWhether transport or a recipient received it\t\nNotifications listed\tREAD\tWhether a person understood or accepted the work\t\nPersonal SOS started or stopped\tSTART or STOP\tWhether every recipient acted on the latest state\t\nOperator not picked up before 90 seconds\tProposed manager handoff\tWhether the next person is available\t\nPicked up, not closed before 105 seconds\tProposed manager handoff\tWhether evidence or another dependency delayed the judgment\t\nCorrecting an accidental request after it has been sent\nCaution\nCancellation may need a continuing response. Suppose the person realises the request was accidental and cancels it. Before transmission, cancellation may stop the local operation. After receipt, it is a new piece of information for the service. After someone has begun an external action, that action may have its own withdrawal process. A cancelled screen cannot make the earlier request cease to have existed.\nThe interface can carry the correction forward: when it was requested, whether the service received it and whether a reviewer acknowledged the change. It can also distinguish an intended withdrawal from a confirmed one. This is especially important after reconnection, when delayed messages may arrive in an unexpected order. A later view should not quietly restore an old active state simply because an earlier message finished travelling. The design question is how to keep the evolving request coherent across the people and systems holding it.\nConfiguration creates another kind of interruption. A missing contact, disabled permission or unavailable connection may prevent a particular action. An urgent interface should make the obstacle specific and take the person towards the relevant correction where that is possible. A general “setup incomplete” message hides the actual problem. Equally, a setup checklist presented as a prerequisite for every request can trap the person in administrative work at the moment they need a usable path. Which limited actions remain possible under an incomplete setup is a product decision that has to be explicit.\nThe reviewer has a different interface\nOn the receiving side, selecting the next incident and deciding what it means are separate movements. A queue helps allocate attention; a review view helps interpret evidence. Mixing them can encourage a reviewer to settle a label while merely trying to move the queue along. Relevant context includes the kind of request, available observations, their age, prior actions and the commitments already accepted. More panels are useful only if they help someone answer one of those questions.\nConsider two constructed events: a deliberate request waiting for acknowledgement and an automatic alert with an incomplete camera view. Their visual presentation should preserve the difference in origin and missing information. Giving both a red tile marked “emergency” makes them easier to count but harder to understand. Conversely, a very elaborate category tree can make urgent work slow to find. Priority rules need a reason grounded in the response arrangement and actual evaluation, not just an attractive ordering of labels.\nCare's people view also separated event state from relationship affinity. Its proposed ordering put an unattended SOS ahead of an active SOS, followed by the high-alert states; family, friend and co-worker relationships ordered people within an event class rather than overriding it. The design idea is that a close relationship and work needing attention now answer different questions. In a constructed view, an unattended request from a co-worker should not disappear beneath routine activity from a favourite contact simply because that contact is closer to the user. The exact ranking still needs evaluation against the intended operation. A relationship label can help somebody recognise a person, but it neither establishes response competence nor grants permission to act for them.\nIndustrial alarm design offers a neighbouring principle. The UK's HSE alarm-management guidance relates alarms to a defined operator response and the time available to make it. Its context is process operations, not a validated priority scheme for personal emergencies. The transferable question is whether a signal directs someone towards meaningful work. An attention-grabbing alert with no actionable context consumes the same scarce attention that the service depends on.\nThe final interface is therefore larger than the emergency button. It includes the correction, the acknowledgement, the evidence view and the transition into accepted work. The person asking for help can understand what has reached the service; the reviewer can see what remains uncertain and which commitment is theirs to carry. A well-shaped interface makes room for both actions, with display states that keep their different meanings intact.\n","url":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/coordinating-emergencies/","identifier":"collection:dao-studio-coordinating-emergencies","@type":"CollectionPage","name":"Coordinating emergencies","url":"https://daostudio.in/collections/coordinating-emergencies/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/#article","identifier":"content:dao-studio-pending-is-not-noise","@type":"Article","name":"The cases that are still waiting","headline":"The cases that are still waiting","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["emergency-response evaluation","pending judgments","process exceptions","evaluation denominators","reviewer incentives"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/","@type":"WebPage","name":"The cases that are still waiting","url":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Coordinating emergencies","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/"}},{"@type":"ListItem","position":2,"name":"The cases that are still waiting","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/"}}]}]},"description":"An unfinished judgment changes how a response service should understand its results, workload and incentives.","datePublished":{"@value":"2024-07-29","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"The cases that are still waiting\nA reviewer has examined the image and called the person responsible for the property. The call remains unanswered. At the end of the shift, the case is still waiting, but the report wants a result: success, failure or false alarm. Which box should the reviewer choose?\nThe report is asking for a completed judgment before the service has obtained one. The missing answer belongs to work somebody may still finish. An event the process has no way to handle needs a different intervention. YOJN Care brings these questions together: where did the response stop, and what would let it continue? Tidying the report must not erase the work.\nA pending case still holds a question\nUntil the contact replies, the service can preserve what the reviewer has already established alongside what still needs confirmation. Counting the case as a false alarm makes that missing confirmation disappear; counting it as a completed response makes the service look more effective than the record supports. The pending state needs to carry the question still open and a path through which it might be resolved. It is temporary uncertainty about a particular case, rather than a permanent bin for whatever the reporting system finds inconvenient.\nProcess noise asks another question: did something happen outside the categories or assumptions used to describe the workflow? That can reveal a missing branch, a failed process or an inadequate model of the operation. A pending confirmation might be resolved through an existing contact path. An event that no branch can describe might require a change to the process itself. Preserving the difference lets the service improve the right thing instead of asking a reviewer to force both into a final label.\nA catalogue is a way to examine the design\nWork through the combinations of observations and response routes, and the ordinary flow soon branches. An image is incomplete. The owner cannot be reached. A reviewer and a later validator disagree. The event changes while somebody is handling it. A catalogue of such cases asks what the service can know and do at each point, including the paths an ordinary-case diagram might leave out.\nThe catalogue's value lies in coverage of possibilities. Ten designed cases for one outcome and ten for another can help expose different decisions without implying that the outcomes occur equally often. Those proportions describe how we constructed the catalogue. Field observations would answer the separate question of frequency. Keeping that distinction visible lets the design explore cases freely without turning its assumed distribution into a reported operating rate.\nWhich cases are we counting?\nSome cases reach authorities; some are forwarded to the community as crime; some look suspicious and are later judged otherwise. These groups overlap. A case forwarded as crime and subsequently validated as crime belongs both to the forwarded-crime group and to all completed outcomes. Dividing by either group gives a meaningful fraction, but answers a different question. Cases still awaiting that judgment remain outside both completed groups until an answer arrives.\nExamine a case group\nLet V be the number forwarded as crime and validated as crime, C the number forwarded as crime whose final validation is complete, and N the number of completed outcomes. Then V/C asks what share of forwarded crime labels agreed with validation; V/N asks what share of all completed outcomes took that confirmed-crime path. The comparison below keeps track of the cases counted in each term.\nValidated crime cases sit inside completed forwarded-crime cases and all completed outcomes, while pending and other unresolved events remain in the full recorded population.\nThe boundaries show which cases belong inside each population, not their relative numbers.\nComparison\tDenominator\tWhat it asks\t\nValidated crime among completed forwarded-crime cases\tForwarded-crime cases with final validation\tHow often did this particular label agree with validation?\t\nThe same validated-crime group among completed outcomes\tAll completed outcomes\tHow much of the completed work took this path?\t\nCases awaiting final validation\tAll recorded events\tHow much recorded work is awaiting final validation?\t\nFor unfinished work, let P count cases awaiting final validation and R count every recorded event once in the same reporting window. Then P/R gives the pending share. R includes completed outcomes, pending judgments and unresolved process exceptions; it is not silently replaced by N+P. An exception can still need process repair even when it is not waiting for the particular validation that defines P.\nUnderstating a crime as suspicion creates a different problem from repeatedly asking people to examine false alarms. Both deserve investigation. Keeping them separate lets the service ask where it missed a serious event and where it created unnecessary work, without expecting one percentage to explain both.\nThe denominator changes the answer\nImagine a service with 100 recorded events:\nState at the reporting time\tEvents\tShare of all recorded events\t\nResolved\t60\t60%\t\nPending\t20\t20%\t\nProcess exception\t20\t20%\t\n“Resolved” identifies a completed judgment, not sixty successful responses. Agreement with a later validator could be calculated within those sixty cases, if the relevant judgments exist. It would not describe the other forty. Treating the twenty pending cases as failures would instead turn an unfinished judgment into a final one for the convenience of calculation.\nThe denominator follows the question. A comparison among completed reviews can describe agreement with validation. A view across all recorded events shows how much remains unresolved and how often the process encountered an exception. Keeping these questions recognisable makes it possible to examine good completed work alongside a growing backlog, instead of allowing one attractive success rate to stand for both.\nWhere the delay develops\nA correct detection can wait in a queue. A reviewer can receive incomplete evidence. A handoff can lose the context needed for the next decision. The last person attached to the case is not necessarily the cause of its delay or outcome. The record needs enough of the sequence to distinguish when the evidence became available, when work was accepted and where the next action stalled. Otherwise the score measures where the case ended up rather than what the person did.\nConsider two reviewers in a constructed comparison. One receives a clear view and reaches a judgment quickly. The other receives an old frame, requests a new observation and leaves the case pending. A speed-only ranking rewards the first outcome without describing the different work. A ranking that treats every pending case as incompetence penalises the second reviewer for preserving a question the evidence could not answer. Neither comparison tells us whether a reviewer made good use of what was available. That requires the conditions and the judgment to be examined together.\nLook at the pattern before blaming the last person attached to a case. Consistent failure across the service calls for examining its rules; intermittent system-wide failure may point to how work is distributed. Problems across several teams can call for training, while a local cluster may reveal a staffing gap. Individual handling still matters, but it has to be examined within those conditions.\nA client's classification may be the agreed operational reference, but it is still a judgment made from a particular position. A later answer may have more context than the reviewer had, or may describe the whole incident while the initial label described one observation. Disagreement can reveal a real mistake, a changed event or a mismatched question. Looking at the evidence available at each point helps distinguish them without making either participant automatically correct.\nWhat a score teaches the reviewer to do\nEvaluation changes the work when it becomes an incentive. Suppose completed cases earn a reward while unresolved cases count against a reviewer. That arrangement creates a reason to finalise a label before the missing confirmation arrives. If agreement with a later client judgment is the only rewarded result, guessing the expected answer may become more attractive than describing uncertainty accurately.\nHolmström and Milgrom's multitask incentive analysis examines how rewards for measurable work can redirect attention away from other valuable duties that are harder to measure. Its formal model is not a ready-made compensation policy for a response service. The relevant question is what a score encourages the reviewer to neglect. Speed, careful interpretation, context gathering and a reliable handoff can compete for the same attention even though the service needs them together.\nAdding more scores does not automatically repair the incentive. A count of evidence requests could reward unnecessary requests. A penalty for disagreement could discourage challenge to a poor reference judgment. The comparison needs an account of good handling before its numbers acquire consequences. Reviewing a sample of completed, pending and disputed cases can help expose what the measures are missing; the review itself needs enough independence and context to avoid simply reproducing the original label.\nAccountability remains possible within this richer account. A reviewer can ignore available evidence, leave an accepted task unattended or fail to make a required handoff. Naming the actual failure makes feedback more actionable than a general penalty for a disappointing outcome. It also leaves room for service-level failures to be corrected as service-level failures. Good individual decisions still depend on capacity and recurring work across the service; a performance score cannot supply the missing shift or maintain the equipment carrying the evidence.\nA changing service changes the comparison\nA revised detector changes which events enter the workflow. A revised procedure can change what a label means. A different staffing arrangement can change handling time. A before-and-after comparison that omits those changes may attribute improvement to the wrong cause, especially if the easier cases enter one period and the difficult cases another. The conditions under which the result was obtained are part of what makes the result interpretable.\nThe point of evaluation is to make the service easier to understand and improve. A useful account can show a reviewer making a sound judgment, a connection preventing review and an unanswered confirmation in the same operation. Those distinctions keep uncertainty available for work instead of silently converting it into achievement or error. Pending then becomes a question someone can pursue, rather than noise the report learns to hide.\n","image":[{"@type":"ImageObject","contentUrl":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/case-populations-light.svg","description":"Validated crime cases sit inside completed forwarded-crime cases and all completed outcomes, while pending and other unresolved events remain in the full recorded population.","caption":"The boundaries show which cases belong inside each population, not their relative numbers.\n"}],"url":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/coordinating-emergencies/","identifier":"collection:dao-studio-coordinating-emergencies","@type":"CollectionPage","name":"Coordinating emergencies","url":"https://daostudio.in/collections/coordinating-emergencies/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/#article","identifier":"content:dao-studio-the-cost-of-continuing-response","@type":"Article","name":"The cost of continuing response","headline":"The cost of continuing response","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["response-service economics","staffing in whole steps","arrival patterns","active handling time","queueing","recurring maintenance"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/","@type":"WebPage","name":"The cost of continuing response","url":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Coordinating emergencies","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/"}},{"@type":"ListItem","position":2,"name":"The cost of continuing response","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/"}}]}]},"description":"How staffing, arrival patterns and recurring operational work shape the economics of a response service.","datePublished":{"@value":"2024-08-05","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"The cost of continuing response\nAn alert can be inexpensive to produce and expensive to resolve. Once a service promises that somebody will examine the event, obtain missing context and carry a response forward, its cost extends beyond the notification. The continuing work is part of the product. If the business model counts only the software transaction, it can make a growing service appear healthier while the people behind it absorb an increasing burden.\nYOJN Care’s ambition was a more affordable response service for homes, shops and neighbourhoods, combining detection with human review and community or authorised response routes. Its economics therefore depended on the relationship between monitored sites, customers and the people carrying the queue. More cameras meant more possible evidence sources. More subscriptions meant more commercial commitments. More active events meant more work now. Those counts were connected, but none could substitute for the others in an account of capacity or revenue.\nStaffing grows in whole steps\nThe integrated service models behind Care budgeted one operator per 100 paying Tier 2 customers, rounded up, then one manager per ten operators, also rounded up. These ratios counted paying subscriptions. The handling capacity still depended on when events arrived and how much work each required. At 100 customers the formula gives one operator; at 101 it gives two. At 1,000 it gives ten operators and one manager; at 1,001 it gives eleven operators and two managers.\nBudgeted operator and manager counts rise in whole steps as paying Tier 2 customers increase.\nCrossing a staffing threshold adds a whole person to the budget.\nA model with that shape cannot spread its people costs as though every additional customer buys an infinitesimal fraction of a new shift. Equipment, desks, electricity, connectivity and staff welfare were also part of the design. Purchases associated with additional staff differ from recurring pay and from the use-driven costs of calls or transferred media.\nThe models also explored public funding and distribution through associations, alongside paying tiers. Those were proposed routes to making coverage affordable, not committed funding or authorised participation by any public body or association. A low subscription price still needed a credible account of who paid for the rest of the operation.\nTwenty cases in an hour\nConsider an illustrative service receiving twenty cases in an hour, with six minutes of active handling per case. That creates 120 person-minutes of work: the equivalent of two people working continuously for the hour. It says nothing yet about breaks, shift changes, unexpected complexity or the speed at which a new case can begin. Nor does it establish that two people are adequate for the service's response commitments.\nThe arrival pattern can change the experience without changing the total. Give the toy service two reviewers, assume every case takes exactly six uninterrupted minutes, and omit handoffs and all other work. The contrast is already substantial:\nArrival pattern\tFirst cases begin\tLast case begins\tWaiting before active handling\t\nAll twenty arrive at minute zero\tImmediately, two at a time\tMinute 54\tLast pair waits 54 minutes\t\nOne arrives every three minutes\tImmediately\tOn its arrival at minute 57\tNone under these simplified assumptions\t\nBoth patterns require 120 person-minutes. In the burst, the reviewers complete ten successive pairs; the last pair cannot start until nine six-minute intervals have passed. The workload total alone says nothing about that wait.\nHandling time itself has several forms. Examining an image consumes attention. Waiting for a contact to answer may consume less attention but leaves a case open and creates work when the answer arrives. A handoff may involve two people for part of the interval. Counting every open case as continuous labour overstates one kind of load; counting only button presses erases another. The operation needs to distinguish elapsed case time, active work and the number of cases a person can carry coherently.\nLittle's queueing result relates long-run average number in a system, arrival rate and time in the system under its conditions. It helps explain how work accumulates. A deadline asks a further question about the distribution of waiting, the response arrangement and the consequences of delay, not only its average.\nThe next customer may require a whole new step\nSome costs grow with use: media transfer, storage, calls or other consumed services. Others arrive in steps. Additional shift coverage requires people even before the new capacity is fully used. A new site may require an installation, device configuration and someone able to maintain it. Additional operating space or equipment creates a different cash requirement from a monthly cloud bill.\nThis produces a changing relationship between scale and cost. A service with spare capacity may be able to carry more customers without immediately adding a shift. At a capacity boundary, the next group of customers may require a substantial addition. Spreading all costs smoothly across each subscriber can conceal that step. Treating initial equipment and setup as though they recur identically every month creates a different error. A useful economic model distinguishes the work and the timing of the expenditure before averaging it into a unit cost.\nRevenue has its own units and timing. An installed site is not necessarily a paying subscriber, and a payer may cover several monitored sources. Acquisition can bring people into the service without converting them into the recurring revenue expected by the model. Cash may arrive after the installation and staffing cost has already been incurred. Growth can improve utilisation while increasing the money needed to keep the service running through the transition.\nAcquisition and response are different operations\nA distributed partner network can help reach and install more customers. That is a route to acquisition, not an automatic multiplication of response capacity. A partner able to onboard several sites a day may have no role in reviewing their events. If demand is pooled centrally, the shared queue must absorb the new work. If response is local, coverage and escalation need to remain viable in each local operation. Neither arrangement becomes sustainable merely because the onboarding numbers are strong.\nThe confusion is easy to build into a model. Divide a customer target by the number of customers onboarded per day and the result is a number of days, not operators; manager and salary lines calculated from it cannot show the capacity or surplus their labels suggest. A falling cost per customer needs the same care: a cost worked out for one number of paying users cannot be carried into a column that assumes another.\nThere is also recurring work between incidents: checking contact details, maintaining equipment, correcting configuration, training people and examining failures. Omitting it from the model treats continuity as free. Moving it to the customer may lower the provider's cost while changing who has to do the work and how dependable the service is. That is a product choice with consequences for use, not just a favourable change in a spreadsheet.\nAutomation can reduce a specific part of this burden. Better evidence grouping may save repeated review; a reliable routine notification may save manual contact. But a detector that produces more candidate events can increase downstream work even while its computation becomes cheaper. The useful measure is the work required to complete the response at the intended quality, including exceptions, rather than the cost of the automated stage alone.\nThe economic question is ultimately whether the service can keep its commitment under the conditions in which customers use it. Unfinished reviews still need capacity, and the path carrying their evidence still needs maintenance. A credible model gives that recurring work a place in the cost of continuing. Growth can then be examined for the response the operation can sustain, including the labour and spare capacity on which its promise depends.\n","image":[{"@type":"ImageObject","contentUrl":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/staffing-steps.svg","description":"Budgeted operator and manager counts rise in whole steps as paying Tier 2 customers increase.","caption":"Crossing a staffing threshold adds a whole person to the budget.\n"}],"url":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/coordinating-emergencies/","identifier":"collection:dao-studio-coordinating-emergencies","@type":"CollectionPage","name":"Coordinating emergencies","url":"https://daostudio.in/collections/coordinating-emergencies/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/#article","identifier":"content:dao-studio-the-evidence-path","@type":"TechArticle","name":"The evidence path","headline":"The evidence path","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["camera evidence","degraded connection","heartbeats","capture time","retries","device maintenance"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/","@type":"WebPage","name":"The evidence path","url":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Coordinating emergencies","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/"}},{"@type":"ListItem","position":2,"name":"The evidence path","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/"}}]}]},"description":"What it takes for a connected deployment to deliver usable, timely evidence to the person reviewing an event.","datePublished":{"@value":"2024-07-08","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"The evidence path\nA device can report that it is connected while the person reviewing an event has no usable image. The network may still carry small messages while struggling with video. The camera may be sending a black frame. A recent upload may contain an old capture. Each situation leaves a different part of the service working and a different question unanswered.\nThe useful question is whether the reviewer can see enough, soon enough, to decide what to do. A running process cannot answer that. YOJN Care brings the problem into view through four flows between the premises and the reviewer, each carrying something different.\nFour signals, four different questions\nA heartbeat says the device was reachable. Event metadata says something happened. Images and video let a person examine it. Device and network information help explain a failure. In the figure, A carries heartbeats, B event metadata, C media and D system information. Small heartbeats travel frequently; larger media arrives when an event needs it. They share a connection without answering the same question.\nOne notification has metadata before its media is ready; media completion starts the review allowance, while heartbeats and vitals answer separate questions.\nThe metadata and media belong to the same notification. In this delayed-start option, the review allowance begins when the media is ready; lengths do not represent measured durations.\nSeparating the flows lets a notification arrive before its image. The review allowance can then begin when the image loads, or loading time can be added to it. Either way, waiting for evidence should not consume the time meant for judging it. A failed upload also needs its own investigation; blaming the reviewer will not restore the image.\nSeveral flows share one connection\nImagine a site whose connection has become severely constrained. Small periodic messages still arrive, an alert reaches the queue, and an image upload remains unfinished. Calling the site “online” accurately describes one exchange but conceals the reviewer's situation. Calling it wholly “offline” loses the information still available. A more useful account names what is working: the device was recently reachable, an event was reported, and its supporting media has not yet become available.\nThis distinction changes the design of degradation. An event notice may need to travel before a large media transfer completes. A smaller preview might support some judgments while a full stream is unavailable; other judgments may remain impossible. Reducing payload or reserving capacity for a control message can help a particular path, but neither creates missing visual detail. The product has to know which decision a degraded view can support, rather than give every delivered artefact the authority of the original evidence.\nIt also changes diagnosis. Power loss, a disconnected camera, a saturated uplink and an application failure can all produce a missing image. A timeout alone does not identify which happened. The system needs observations along the chain: capture, processing, transfer and presentation. That chain should help someone locate the failure without forcing the reviewer to become a network engineer before they can mark the evidence unavailable.\nDelivery is only part of that chain. A camera moved during maintenance may keep streaming while losing the view the review procedure depended on. Poor placement, a noisy feed or a changed reference can leave an image technically available but unhelpful for the intended judgment. Device power and access to the camera source affect whether capture can happen at all. Installation therefore establishes part of the evidence arrangement: what is being observed, through which devices, and who can restore it when the physical setup changes. Network repair alone cannot recover a view that no longer contains the needed scene.\nGoogle's SRE chapter on monitoring distributed systems distinguishes internal instrumentation from checks of externally visible behaviour. For an evidence service, that suggests two complementary questions: do the components appear healthy, and can an authorised review session actually receive a usable result? An end-to-end check can expose a broken path that individual health checks miss. It still needs realistic conditions and cannot establish that every image has the context needed for a human judgment.\nHow old is this picture?\nSuppose a frame was captured before a connection failed, received after reconnection and displayed immediately. For this timeline, take a shared trusted clock:\nEvent\tTime\tMeaning at display\t\nFrame captured\t10:00:00\tThe scene was observed three minutes earlier\t\nUpload received\t10:02:58\tTransport completed two seconds earlier\t\nReviewer sees the frame\t10:03:00\tThe presentation is new; the observation is not\t\nAn interface showing only “received two seconds ago” invites a different interpretation from “captured three minutes ago.” Keeping both times gives the reviewer the relevant distinction. In a real multi-device path, the clock uncertainty also belongs beside the comparison; apparent precision cannot synchronise the devices by itself.\nAge matters in relation to the decision. An older image might help establish how a scene changed, while being insufficient to show what is happening now. A live label cannot carry that judgment on its own. The interface needs to distinguish the latest available capture, a current stream and historical evidence, then make a gap in observation visible. Otherwise a freeze can look like a calm scene, and the absence of new information can acquire a meaning it never earned.\nReconnection brings ordering as well as freshness problems. A delayed alert may arrive after a newer correction. Several attempts to send the same request may all complete. Identifying the event and the relevant change lets the receiver reconcile these messages instead of treating each arrival as a new incident. Where a message initiates an external action, duplicate handling becomes more consequential than duplicate display: retrying the transport should not unknowingly repeat the commitment.\nRetrying on a line that is already full\nRetries are useful when a failure is transient. They also consume resources. If every device immediately repeats a large transfer during congestion, recovery traffic can compete with the very evidence the service is waiting for. AWS's guidance on limiting retries explains the load created by retries, including compounded attempts across layers, and the role of backoff, jitter and a limit on attempts. Its warning about non-idempotent calls is especially relevant when repeating a request could repeat a side effect.\nThe service design question is what to recover first. A short message describing the missing evidence may be more immediately useful than another full upload. The latest relevant capture may matter more than an undifferentiated backlog. Historical material may still need retention for review, but it should not crowd out current work by accident. These choices depend on the incident, the available capacity and what the reviewer needs; an indiscriminate “retry until success” policy avoids that judgment rather than solving it.\nMoving inference onto a local device changes this path without eliminating it. The device may continue detecting something while disconnected from a remote service. Human review, external notifications and coordinated response may still depend on connections outside it. Local compute can preserve a particular capability through a network interruption, but the product needs to identify that capability precisely. Installation and device maintenance remain part of whether it can continue operating at all.\nCare's early Raspberry Pi route brought that operational burden into view. The hardware path was abandoned while installation, device management, manpower and logistics remained unresolved. A later Windows and vendor-software alternative brought recurring costs and integration dependence into the design. The general economic lesson is that a cheap detector can sit inside an expensive delivery arrangement. Provisioning devices, travelling to sites, restoring failures and maintaining compatible integrations all require resources. Comparing the detector's price with a hosted alternative while omitting those responsibilities compares different services. Continuing-response economics needs the whole usable path, including the work that keeps its physical endpoints in place.\nWhat matters is the decision the available evidence can support. If an event is visible but its media is unavailable, the case remains unresolved for a particular reason. The evidence path makes that reason available to the operation: a reviewer can identify what is missing, and the people maintaining the service can investigate where it disappeared. That is more useful than a green or red connection indicator. It connects the state of the system to the work somebody can now do.\n","image":[{"@type":"ImageObject","contentUrl":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/evidence-arrival-light.svg","description":"One notification has metadata before its media is ready; media completion starts the review allowance, while heartbeats and vitals answer separate questions.","caption":"The metadata and media belong to the same notification. In this delayed-start option, the review allowance begins when the media is ready; lengths do not represent measured durations.\n"}],"url":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/coordinating-emergencies/","identifier":"collection:dao-studio-coordinating-emergencies","@type":"CollectionPage","name":"Coordinating emergencies","url":"https://daostudio.in/collections/coordinating-emergencies/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/#article","identifier":"content:dao-studio-detection-is-not-dispatch","@type":"Article","name":"Who carries the incident?","headline":"Who carries the incident?","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["emergency coordination","incident context","human review","response handoffs","notification suppression"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/","@type":"WebPage","name":"Who carries the incident?","url":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Coordinating emergencies","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/"}},{"@type":"ListItem","position":2,"name":"Who carries the incident?","item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/"}}]}]},"description":"An alert reaches several people; the response depends on keeping its evidence and next commitment together.","datePublished":{"@value":"2024-07-15","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"Who carries the incident?\nImagine a person appearing in a camera frame after a shop's usual hours. The system raises an alert, a neighbour opens it and a monitoring operator receives the same event. Who is carrying it now? The neighbour may assume the operator will act. The operator may be waiting for the owner to explain the scene. The notification has travelled successfully while the responsibility remains between people.\nThis is the problem behind YOJN Care: how to keep an incident together as different people try to make sense of it and decide what to do. A better detection can help them begin. It cannot tell the next operator what the owner said, whether a neighbour agreed to investigate or who is still waiting for an answer.\nAn alert needs the knowledge people hold about the scene\nThe owner might recognise authorised staff where the neighbour sees an unfamiliar person. The operator may have neither person's knowledge. A reference view, the property's instructions and other observations give them something to judge together. The person in the frame has not changed; what they know about that person has.\nA personal SOS starts somewhere else. Somebody has deliberately asked for help. They should not need a camera to corroborate the request before it becomes worth attending to. Keeping that origin visible tells the reviewer what question they are answering.\nNotifications have to become an incident somebody can follow\nTwo cameras might show the same person, and each might send several frames as the person moves. Treating every notification as a new case makes more work while scattering the evidence needed to understand any one of them. Group them, and the reviewer can see what changed. A judgment on the first frame can sit beside a later observation still needing attention.\nThe same context matters when the shift changes. The incoming operator needs the views already examined, the call made to the owner and the unanswered question. Otherwise the handoff merely gives somebody else the job of reconstructing the incident.\nA mixed incident keeps repeated notifications from two cameras together when a selected notification passes to the next handler.\nAn example of the mixed case, with arrival order retained across a handoff; spacing does not represent elapsed time.\nThe figure combines two kinds of repetition: several cameras observing at once, and one camera observing again. Time, property, camera and classification help decide which notifications belong together. They still need their own judgments. Opening one notification within the incident should make its neighbours available without marking them all as reviewed.\nAcknowledgement has a limited meaning\nThe neighbour has opened the alert. That tells us something, but not whether they can go to the shop. The operator has accepted the review. That does not give them authority to dispatch help. Even when both have responded to the application, the next action may still belong to nobody.\nFor the shop example, the difference looks like this:\nParticipant\tWhat they have done\tWhat remains open\t\nNeighbour\tOpened the alert and supplied a local observation\tHas not agreed to respond\t\nMonitoring operator\tTaken on the review and called the owner\tStill waiting for the owner's answer\t\nResponse participant\tNo acceptance recorded\tNobody yet confirmed to take the next action\t\nA useful handoff says which commitment someone has made. “Seen” cannot do the work of “I will continue from here.” Nor can a list of nearby contacts establish that any of them is available.\nTime changes the problem, but a timer does not solve it\nWhile the operator waits for the owner, more cases arrive. Some need a quick check; others need a call or an image that has not finished loading. Counting all of that time as neglect would rush necessary work. Letting every active case wait indefinitely would hide the growing queue.\nA review clock can make that wait visible and pass a case to someone else. Care's clock example follows the allowances for community, operator and manager review, including time spent loading evidence and making calls. Those are handling windows. They do not measure how long it takes help to arrive.\nThe next person must also be able to take the case. A manager on a call, an operator on a break and a disconnected workstation cannot absorb the same work as an available responder. And passing a timer's deadline cannot create authority: an escalation to emergency services needs an agreed route and their participation.\nA quiet screen can mean several different things\nSuppose the operator has judged the scene suspicious. Another frame may show the person leaving, or reveal something more serious. Continuing to record matters. Asking the operator to repeat the same judgment for every frame may not.\nThat leaves two separate choices: whether to keep the observation, and whether to ask for attention again. Silence alone tells the next operator neither. The camera might still be recording while repeated alerts are suppressed. Another person might have taken over the watch. Or the connection might have failed.\nCare's crime-classification rule illustrates the distinction: later notifications could keep joining the incident while further processing was suppressed for two hours. Suspicion had no equivalent cooldown because it could develop into crime. These choices make sense only if the person watching can tell which rule applies. A quiet screen must not look like evidence that the shop is safe.\nThe outcome can exceed the application's account\nThe owner might call the police directly. A responder might arrive without updating the interface. An absent update then means the application does not know, rather than that nothing happened. The reverse error is just as consequential: a recorded request does not establish arrival or resolution. An unanswered question needs to remain available for someone to pursue.\nReturn to the shop at the change of shift. The incoming operator has two views, knows why the owner was called and can see that an answer is still due. They know who has offered to help and what remains unassigned. That is something they can continue. Without it, the system may keep delivering every alert correctly while everyone waits for somebody else.\n","image":[{"@type":"ImageObject","contentUrl":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/incident-context-light.svg","description":"A mixed incident keeps repeated notifications from two cameras together when a selected notification passes to the next handler.","caption":"An example of the mixed case, with arrival order retained across a handoff; spacing does not represent elapsed time.\n"}],"url":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/coordinating-emergencies/","identifier":"collection:dao-studio-coordinating-emergencies","@type":"CollectionPage","name":"Coordinating emergencies","url":"https://daostudio.in/collections/coordinating-emergencies/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/protocols-and-reuse/","identifier":"collection:dao-studio-protocols-and-reuse","@type":"CollectionPage","name":"Protocols and reuse","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"What shared AI capabilities must preserve, and what decentralisation would actually add.","text":"Useful work should be able to accumulate. A team that has made an invoice-reading capability reliable ought to be able to contribute something to the next application without rebuilding the entire service. The difficulty is deciding what that contribution actually contains. A package of code, a customer's business rules, a trained model and an operating service ask different things of the team receiving them.\nAn interface tells a consumer how to invoke a reusable capability; its version, dependencies and evaluation help explain when the result can be useful. The conditions of use determine whether it can travel at all. Service work can reveal the repeated need, while still leaving a particular customer's data and commitments with them. The next adoption becomes easier through a stable contribution, not through quietly carrying those private dependencies forward.\nA network adds both a coordination problem and an institutional one. Contributors and consumers may need a common account of which version was supplied, which terms were accepted and what happened to a transaction. They also need a way to challenge a decision or change a rule. A shared ledger can help participants maintain the account; it cannot appoint the people entitled to decide for them. Discovery and adoption ask whether a contribution is useful. Governance asks how the resulting relationships remain answerable to their participants.\nDAOnet and the protocol proposals around it are a design for infrastructure for an economy of these capabilities: discovery and composition, memory management, observability, execution and transactions. A protocol earns its place by making a dependency easier to understand or an interaction easier to coordinate. Its value would have to reach the contributor and consumer doing useful work, rather than depend entirely on the network becoming large.\nThere is also a deeper, more speculative possibility: identifying learned capacities inside models and recombining them. That would require understanding their representations and dependencies, beyond the interfaces that connect separate capabilities. Application composition offers a concrete starting point for reuse, with intermediate state, execution records and feedback that surrounding people and software can already reason about. The wider ambition asks how much more of useful intelligence could become an intelligible contribution.\n","url":"https://daostudio.in/collections/protocols-and-reuse/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"hasPart":[{"@id":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/#article","identifier":"content:dao-studio-what-a-github-for-intelligence-must-preserve","@type":"Article","name":"Some things never change. It’s time they do…","url":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/"},{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/","identifier":"journey:dao-studio-judgment-before-action","@type":"CollectionPage","name":"A court before the consequence","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/","identifier":"journey:dao-studio-judgment-before-action","@type":"CollectionPage","name":"A court before the consequence","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Protocols and reuse","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/"}},{"@type":"ListItem","position":2,"name":"A court before the consequence","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/"}}]}],"description":"From a judgment people can contest to the release of the version it examined and the common record of both.","text":"An AI that could rewrite its own safeguards prompted the thought experiment of a precognition court: put the rules outside the actor’s unilateral control, and make an action pass their judgment before it happens. The proposal brings two problems together. People need a way to govern and improve the rules, and the machinery carrying the action needs to respect the decision.\nA document service makes their connection visible. An objection to a report asks who can examine the rule, hear the challenge and correct a mistake. A change to the approved report then asks which version may be released and what happens if another route can bypass the decision. The institution and the execution path need each other, but neither can supply the other's answer.\nA common ledger is interesting within that relationship: participants could coordinate an exchange or a review without giving one organisation sole control of its only account. The protocol ambition was useful shared action, with a record the people depending on it could inspect and contest. Its value depends on the judgment and consequence it helps connect. The wider possibility is an arrangement people can question, correct and rely on, rather than merely a durable record of whatever the actor chose to do.\n","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/protocols-and-reuse/","identifier":"collection:dao-studio-protocols-and-reuse","@type":"CollectionPage","name":"Protocols and reuse","url":"https://daostudio.in/collections/protocols-and-reuse/"}],"mainEntity":{"@type":"ItemList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/#article","identifier":"content:dao-studio-a-ledger-cannot-decide-what-is-legitimate","@type":"Article","name":"A precognition court for AI","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/"}},{"@type":"ListItem","position":2,"item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/#article","identifier":"content:dao-studio-approval-effect","@type":"Article","name":"When an approval reaches the effect","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/"}}]}},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/#article","identifier":"content:dao-studio-a-ledger-cannot-decide-what-is-legitimate","@type":"Article","name":"A precognition court for AI","headline":"A precognition court for AI","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["AI safety","precognition court","blockchain governance","AI fail-safe","decentralisation"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/","@type":"WebPage","name":"A precognition court for AI","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":3,"itemListElement":[{"@type":"ListItem","position":1,"name":"Protocols and reuse","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/"}},{"@type":"ListItem","position":2,"name":"A court before the consequence","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/"}},{"@type":"ListItem","position":3,"name":"A precognition court for AI","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/"}}]}]},"description":"A thought experiment in keeping an AI from rewriting its own rules: a shared ledger, an independent court and people who can improve the law.","datePublished":{"@value":"2024-01-03","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"A precognition court for AI\nImagine an AI powerful enough to rewrite its own programming. We have given it rules intended to keep it safe. What stops it from changing those too?\nThat was the question behind my January 2024 thought experiment. If the safeguards live entirely inside the system they constrain, we are asking the actor to preserve the rules against which it will be judged. I wanted to put those rules somewhere it could consult but could not unilaterally rewrite. Blockchain interested me as one possible way to make that separation difficult to undo: a shared account maintained outside the AI, with the AI excluded from control of its consensus mechanism.\nThe ambition was a fail-safe. The thought experiment is how to build one, not evidence that a blockchain has already made an AI safe.\nFirst, it is a ledger\nYou can keep a ledger on paper, in a spreadsheet or in a database. A blockchain is another way of keeping a record, with a protocol through which participants agree on its history. The interesting part here is what it would take for one participant to change a record that others rely on.\nBitcoin's proof-of-work design makes a changed block require new work, including work for the blocks following it. Its security argument assumes that honest participants collectively control more computational power than the attacker. Under that assumption, an attacker's chance of catching up falls as confirmations accumulate. That is a conditional, costly-to-rewrite record, not an infinitely difficult problem. Adding participants alone does not make a network invulnerable. Other consensus designs use different resources and assumptions; Ethereum's proof-of-stake documentation, for example, describes attacks and recovery involving both stake and social coordination.\nThe attraction remains: a powerful program should have to contend with an independently maintained system rather than edit a local file and declare itself exempt. But the independence has to exist in the actual arrangement. A chain controlled by the same actor would give the proposal an impressive name without the separation it needs.\nBall is in your court now\nSuppose the rules are outside the acting AI. My January 2024 proposal went as far as every atomic action: before taking any such action, the AI would submit it to a service that checks it against those rules. Permission or refusal would return before the action proceeds. The decision and the version of the rules used would enter the shared record.\nNote\nA universal ambition. Checking every atomic action was the proposed scope, not a demonstrated capability. Defining the unit of action, checking it quickly enough and dealing with consequences the checker cannot predict remain feasibility questions.\nCall it the Precognition Court: the court is supposed to act before the consequence, rather than merely explain it afterwards.\nThe checking service would be automated but would not itself depend on another AI making an open-ended judgment. It would assess requests, identify patterns among refused actions and feed those patterns into a reward mechanism. Earning that reward would be part of the acting AI's objective, so the system would learn to stay within the rules rather than repeatedly collide with them.\nThere are two different jobs in that proposal. The check decides whether this action may proceed under the current rule. Learning is intended to make future behaviour better. A reward for compliance cannot replace the check: the action still has to meet the rule even while the system is learning. The proposal needs a way to express the action, evaluate it and handle what the checker cannot determine. Those are substantial parts of the problem.\nAn independent check uses a rule version before action; proposals, decisions and observed outcomes return through a shared record for people to review.\nThe proposed court connects three different kinds of work: people changing the rules, a check governing the action, and a record of the decision and observed result. Dashed arrows carry records and review material; they do not make the action path unavoidable by themselves.\nSeparation of church and state\nAsimov's laws offer a familiar image of rules above an individual machine's preferences. The harder question is how those rules acquire enough meaning to govern a real situation, and how they improve when a case exposes a mistake.\nAI researchers cannot answer that alone. The court would bring people from public policy, medicine, social science, psychology, defence and other disciplines into governing the rules. They understand different consequences of an action. The acting system would be a citizen of that arrangement, subject to its laws rather than free to change them whenever they obstructed its purpose.\nThe record of requests and decisions would give those people something to examine. Repeated refusals could reveal a harmful strategy, a badly described request or a rule blocking a legitimate need. They would have to distinguish those possibilities, investigate consequences and amend the rule deliberately. The record supplies cases; it does not supply the answer to every case.\nThat is why keeping the AI outside the voting mechanism matters to the idea. It separates producing an action from deciding the rules under which the action is permitted. The people changing the rules still need a mandate, and the people affected need a way to question them. A technically independent court could otherwise concentrate all the consequential choices in another unaccountable institution.\nThe rule has to reach the action\nMy proposed hardwiring went as far as dedicated circuitry integrated into each deployed AI, routing every command that reached it through the external check and back before continuing. It was meant to make the court compulsory for every atomic action, rather than another instruction the AI could choose to ignore. Ensuring that no action could bypass such a circuit remained part of the problem.\nA smaller, invented example helps expose what that requirement means. A document service prepares a report and obtains approval for version one. It then changes a passage before release. The earlier decision does not automatically approve version two. The release tool has to examine the version actually being sent and the decision that applies to it. If the service also holds an unrestricted upload credential, it can bypass the court altogether.\nThe path from approval to effect therefore matters as much as the record of approval. A common ledger can make an altered account harder to conceal. It cannot, merely by existing, stop an action occurring through a route outside the arrangement. Keeping the rule beyond the actor's control and making the action depend on that rule are connected engineering problems.\nA court people can question\nNow suppose the report contains an error, but the court's rules describe only an initial release. The author wants to correct it; a reader needs to know which version to rely on; the operator needs a procedure it can carry out. A refusal may be faithful to the rule while revealing that the rule is incomplete.\nWho can bring that case? Who can inspect the reasons for the refusal? Who may amend the policy? A useful court needs answers that do not depend entirely on the organisation whose decision is being challenged. Different kinds of expertise help, but expertise and the right to decide for other people are not the same thing.\nA revised policy could distinguish a correction from a new release, identify when it takes effect and preserve the earlier decision in the history. An urgent correction might need a quicker path than a general change to the rules. That path still needs a visible scope; otherwise exceptions become a second policy known only to the operators. The aim is to make a mistaken rule correctable without giving the acting system an unrestricted escape from review.\nThis is the wider possibility that made decentralisation interesting to me: people improving a shared arrangement while the system governed by it cannot simply remove the constraints. Recording votes or allocating tokens does not by itself settle who should govern. The question is what the participants can understand, contest and change, and whether their judgment reaches the action.\nThe helmet\nWhen I first wrote this, I did not expect a rogue AGI any time soon. Relax! This is just a fun thought experiment. The engineering difficulties do not make the question uninteresting. They tell us what the proposed fail-safe would have to survive: a changed rule, a mistaken judgment, an attacker and an action trying to leave through another door.\nMy uncle's advice was simpler: you do not need a helmet every day; you need it on the day you have an accident. You do not know which day that will be, so put it on.\nThat is the spirit of the court. Think about the restraint before the accident, and make sure it is attached to something that can actually restrain the action.\nFor a more grounded view of the state of AI, there is The autocorrect paradox.\nSatoshi Nakamoto, Bitcoin: A Peer-to-Peer Electronic Cash System, sections 4 and 11. The attack analysis depends on relative computational power and accumulated work.\nEthereum's proof-of-stake attack and defence documentation explains the different assumptions and the role of social coordination in some recoveries. Proof of work is not a description of every blockchain.\n","image":[{"@type":"ImageObject","contentUrl":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/court-action-path-light.svg","description":"An independent check uses a rule version before action; proposals, decisions and observed outcomes return through a shared record for people to review.","caption":"The proposed court connects three different kinds of work: people changing the rules, a check governing the action, and a record of the decision and observed result. Dashed arrows carry records and review material; they do not make the action path unavoidable by themselves.\n"}],"url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"mentions":[{"@id":"https://daostudio.in/daonet/#entity","identifier":"project:daonet","@type":"CreativeWork","name":"DAOnet","subjectOf":[{"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","url":"https://daostudio.in/daonet/"},{"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/"},{"@id":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","@type":"CollectionPage","name":"DAOnet mentions","url":"https://daostudio.in/daonet/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/","identifier":"journey:dao-studio-judgment-before-action","@type":"CollectionPage","name":"A court before the consequence","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/#article","identifier":"content:dao-studio-approval-effect","@type":"Article","name":"When an approval reaches the effect","headline":"When an approval reaches the effect","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["document approval","approved version","release path","common record","bypassing an approval"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/","@type":"WebPage","name":"When an approval reaches the effect","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":3,"itemListElement":[{"@type":"ListItem","position":1,"name":"Protocols and reuse","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/"}},{"@type":"ListItem","position":2,"name":"A court before the consequence","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/"}},{"@type":"ListItem","position":3,"name":"When an approval reaches the effect","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/"}}]}]},"description":"A document-release example: an approval names the version it examined, the release path checks it, and the record says what happened.","datePublished":{"@value":"2026-10-12","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"When an approval reaches the effect\nA report has been reviewed and approved. Before release, the document service that prepared it changes a passage to answer an objection. Does the earlier approval still apply? A record saying only “approved” leaves the next participant to invent the answer.\nThe useful decision identifies the document, the permitted use and the version the person examined. The release path can then compare what it is about to do with what was accepted. This is where an independent judgment meets the machinery that carries its consequence. Across a network of reused AI capabilities, the kind DAOnet’s design describes, that connection would let a contributor and a receiving team coordinate an actual use, rather than rely on a catalogue entry’s general promise.\nThe version travels with the decision\nThe relationship is small enough to state explicitly:\nStep in the hypothetical release\tObject that must remain identifiable\t\nPropose the document\tThe particular document version and intended use\t\nReview and decide\tThe reviewer, decision scope and version examined\t\nAttempt the release\tThe actual version presented to the release path\t\nRecord the result\tWhat was permitted or refused, and whether the release occurred\t\nApproval of version one does not answer the request to release version two. The release path needs to compare them and return the changed work for a relevant decision. An independent record makes an invented approval harder to conceal; a constrained release path makes bypassing the decision harder. A faithful record cannot stop an unrestricted upload credential, while a gate checking an untrustworthy assertion can enforce the wrong decision efficiently.\nA decision to permit the release is also different from the release happening. The tool may fail, the destination may be unavailable or the attempt may stop before the document becomes accessible. Recording only the permission would leave the participants without an account of the consequence they were trying to govern.\nAn article makes the same distinction familiar. Its author corrects a paragraph after review; the publisher now has different words to examine. Gazette can build the corrected page, but a successful build cannot accept the new paragraph on the publisher’s behalf. The writing, its rendered page and the decision to release it each need to remain identifiable.\nYojnAI’s proposed improvement workflow put a similar distinction inside the application: feedback on a trace, a candidate improvement job, inspection of its result and an explicit push of a chosen version were separate steps. A one-click return to an earlier version belonged to that deployment design. By contrast, a partner application’s trace service could update feedback on an event row; changing that assessment was not itself a decision to deploy different application behaviour. Choosing a version needs the link from reviewed evidence to the actual effect.\nAnother route can undo the arrangement\nSuppose the release tool faithfully rejects the changed document, but the service also holds an unrestricted credential to upload it directly. The court that judges an action before it happens has examined the request without governing the consequence. The second route has to be brought into the arrangement or removed before the judgment can do its intended work.\nAnother actor able to replace the document afterwards creates a related dependency. Following those routes tells us where the control actually reaches and where somebody else's responsibility begins. A common record can make a departure visible; the path carrying the action gives the decision its practical force.\nThe same question applies to an urgent correction. A process can provide a narrow route for it without making every release depend on a general policy amendment. That route still needs an identifiable decision, a scope and an account of the resulting version. Otherwise the exception becomes an alternative publication path with fewer constraints, rather than a way to handle the specific need.\nWhat the shared account contributes\nThe statements entering the common record still depend on their sources. If one participant asserts that a document was approved, the record needs a way to identify the approving party and the decision's scope. If a physical event happened outside the system, a ledger entry cannot manufacture observation of it. Agreement about a recorded statement and evidence for the event are connected but different parts of the arrangement.\nThis helps make the architectural choice more precise. Which disagreement does the shared mechanism resolve? Is the concern an operator altering records, participants seeing incompatible versions or a single organisation controlling access? Signed records or a shared database may answer the particular problem more simply. A new chain also requires adoption, infrastructure and a way to handle its own failures.\nThe document service makes the ambition concrete. A particular version meets a decision, that decision governs a release and the resulting record lets participants examine whether the consequence matched what was accepted. A shared mechanism earns its place if it makes this relationship more dependable across the people involved. The useful achievement is a consequence connected to accountable judgment, with a record people can use to understand and contest it.\n","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"mentions":[{"@id":"https://daostudio.in/daonet/#entity","identifier":"project:daonet","@type":"CreativeWork","name":"DAOnet","subjectOf":[{"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","url":"https://daostudio.in/daonet/"},{"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/"},{"@id":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","@type":"CollectionPage","name":"DAOnet mentions","url":"https://daostudio.in/daonet/mentions/"}]},{"@id":"https://rawthoughts.in/gazette/#entity","identifier":"project:gazette","@type":"SoftwareApplication","name":"Gazette","subjectOf":[{"@id":"https://rawthoughts.in/gazette/","identifier":"content:gazette-introduction","@type":"CollectionPage","name":"Gazette","url":"https://rawthoughts.in/gazette/"},{"@id":"https://rawthoughts.in/gazette/first-publication/#article","identifier":"content:gazette-docs","@type":"TechArticle","name":"Your first publication","url":"https://rawthoughts.in/gazette/first-publication/"},{"@id":"https://rawthoughts.in/gazette/mentions/","identifier":"content:gazette-mentions","@type":"CollectionPage","name":"Gazette mentions","url":"https://rawthoughts.in/gazette/mentions/"},{"@id":"https://docs.rawthoughts.in/gazette/overview"}]},{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/","identifier":"journey:dao-studio-judgment-before-action","@type":"CollectionPage","name":"A court before the consequence","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/#article","identifier":"content:dao-studio-what-a-github-for-intelligence-must-preserve","@type":"Article","name":"Some things never change. It’s time they do…","headline":"Some things never change. It’s time they do…","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["AI interoperability","AI APIs","neural network composition","agent memory","AI capability reuse","blockchain coordination","capability licences"],"mainEntityOfPage":{"@id":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/","@type":"WebPage","name":"Some things never change. It’s time they do…","url":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"Protocols and reuse","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/"}},{"@type":"ListItem","position":2,"name":"Some things never change. It’s time they do…","item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/"}}]}]},"description":"From YojnAI’s memory wrappers to a harder question: how could learned capacities be recombined, and what would useful reuse have to preserve?","datePublished":{"@value":"2024-05-28","@type":"http://www.w3.org/2001/XMLSchema#date"},"dateModified":{"@value":"2026-11-21T09:00:00+05:30","@type":"http://www.w3.org/2001/XMLSchema#dateTime"},"text":"Some things never change. It’s time they do…\nOkay. Before we get into AI interoperability and the possible role of a blockchain, a refresher.\nWhat is a blockchain? In its most rudimentary form, a ledger. A better one, or a worse one, depending on the use case. Cryptography helps participants verify records; a consensus mechanism determines which history they accept. The familiar operations of creating, reading, updating and deleting data take a different shape when participants need to agree on a shared record. “Immutable” is shorthand for resistance to rewriting under the system's security assumptions, not a magical exemption from attack. Once you have that ledger, you can do cool shit with it. DeFi was all the craze a couple of years before I wrote this in May 2024.\nAnd a neural network? At this level of abstraction, a function approximator. Think of a sine wave and the periodic functions it suggests; then think of aperiodic, linear and nonlinear relationships. Given data spread through an n-dimensional space, can a network learn a useful relationship among the values? Fitting those examples is one part. Generalising beyond them is what makes the result useful. I hear “generation” is all the craze these days.\nCool. That's it. No more extra-credit assignments from this point on.\nI lied. There's one more thing.\nWhat's an API? A defined way for software systems to talk to each other. A really awesome one, sometimes. Its usefulness depends on what it lets the other system do.\nThe interface stayed familiar\nSoftware had decades in which to develop its routines, interfaces, deployment practices and containers. Then the post-2022 AI rush made a familiar neighbourhood model, GPT, everyone's business. The question I was asking in 2024 was what happened when we took established software interfaces and translated them almost verbatim into this much younger wave of applications.\nDid you read the paragraph above?\nYes or no?\nThat gives us a simple state to reason about. In an ordinary program, we can often name routines, describe their inputs and outputs, and expose the parts another program needs to call. For a fixed set of inputs and state, a deterministic routine produces a fixed result. Randomness and concurrency can complicate that behaviour, while the named routines still give us parts to examine and compose.\nA trained neural network offers a different problem. We can see its architecture and, where available, its parameters. That does not automatically give us a set of independent, named abilities that can be lifted out and used like ordinary routines. Knowing where multiplication occurs is not the same as knowing where “understands a supplier's exception” lives.\nYet the familiar request-and-response interface is often the first thing we build around it. That is useful. It can also conceal the part we have not learned how to separate.\nConsider Docker and the software engineering practices around containers. They arrived through years of testing, adoption and adjustment. The AI application rush was trying to compress a comparable maturation into a couple of years. Two years versus decades. What could go wrong?\nPlenty.\nZero or one: which part can another system call?\nA modern AI application can look remarkably like an operating system, loosely speaking. Retrieval is part of its input/output path. Context resembles working memory. Agents resemble threads carrying out activities. These are analogies, not literal descriptions of an LLM's internals, but they help locate the work.\nA model is invoked at a particular point in the agent flow. The orchestration framework supplies context, remembers intermediate results, chooses the next call and eventually returns an answer. Much of the application's useful behaviour lives in that arrangement around the model.\nNow let a second system call it. Suppose the exposed choices are only:\nZero: call the base language model.\nOne: call the complete orchestrated application and receive its final answer.\nCalling that final endpoint from an ordinary application may be entirely sufficient. But when one agent system needs to work with another, the choice is limiting. It may need the state reached halfway through a task, the evidence already collected, or a callback when a particular agent has finished. Starting again at the base model discards useful work. Calling the final endpoint asks for more work than the receiving system needs.\nThe problem is not that an API is incapable of carrying state. An application can persist memory and expose finer operations. The problem is that a wrapper which exposes only those two endpoints has not done so. Its caller cannot reach the internal memory merely because the application uses agents. And exposing that memory still says nothing about whether learned abilities inside the underlying model are independently reusable.\nWhat we tried with YojnAI\nWith YojnAI, our approach was to wrap memory states in a data structure and keep caching those states so the application could expose callbacks at the agent level. A caller could work with an intermediate state instead of choosing only between the base model and the final orchestration endpoint.\nThis also let us “teach” the invoked LLMs to work with the wrapper's memory operations during the application flow. The wrapper kept the states; the model could use those operations. That is different from a neural network acquiring a memory subsystem we could lift out and transplant into another model.\nWe built utilities on top of that work and called them Apps. Different story. YojnAI's application design follows those parts through the work a customer needed to do.\nBut even that approach was not enough for the larger question.\nA third possibility: combine the learned parts\nWhat I really wanted was a third scenario: a subnet of one neural network working with a subnet of another. Not merely their final answers passing through an endpoint. The learned capacities themselves becoming composable.\nImagine a model M1 containing capacities I1, I2, I3, …, In, realised through subnets which might overlap. Another model, M2, contains capacities K1, K2, K3, …, Kn, again potentially overlapping.\nHow would you take K2 from M2, and I2 and I3 from M1, to make M3?\nNote\nNaming a capacity does not isolate it. The notation makes the question easy to write. It does not establish that those capacities are cleanly located, separable or compatible. Overlap is part of the difficulty. Removing the part we call I2 might also remove something I3 relies on. Two representations that work within their own models may not mean the same thing when connected.\nThere are two different times at which we might attempt the combination:\nWhen the combination happens\tThe question it raises\t\nBefore deployment, loosely like compilation\tCan selected learned components be aligned and assembled into a new model which preserves the wanted capacities?\t\nDuring execution, loosely like runtime linking\tCan one running system use a selected learned capacity in another, with the representations, state and dependencies needed for that interaction?\t\nPre-deployment composition is a research problem of its own. Work such as Git Re-Basin examines a particular route to aligning and merging model weights. The runtime question reaches beyond what a request-and-response wrapper has solved. Transporting a message cannot, by itself, discover a decomposition of the learned computation or make incompatible representations fit.\nThat was the force of my complaint about the API model. The familiar interface can carry the eventual interaction. It cannot substitute for understanding what is being composed.\nMy gut said a blockchain might have a role here. A shared record could help parties coordinate contributions, versions or use. It would still need something meaningful to record. The road from a ledger to a working M3 is long and hard.\nThe inquiry continues in The intelligence between the parts. It asks what must pass between learned capacities for their combination to retain meaning. There is also nearer work we can do without claiming to have solved that problem: make the capabilities we already know how to share intelligible to their next user.\nSeveral different things can look like intelligence\nA model, a prompt, a dataset, a workflow and a hosted service can each contribute to a useful result, but the next team receives something different in each case. A dataset provides examples, a prompt supplies instructions in a context and a workflow connects operations. A model contains learned parameters, while an endpoint offers a response with much of its implementation remaining at the provider. These forms carry different dependencies and different opportunities to change the behaviour: adopting a prompt leaves the consumer to supply the model and its context, whereas invoking a service leaves more of the operation with the provider. A useful catalogue makes that contribution and continuing responsibility intelligible, so a team can discover the form it actually needs.\nApplication composition is a nearer form of reuse\nConsider two hypothetical document capabilities. One extracts supplier details from an invoice; another checks a proposed payment against the extracted terms. They can be combined through defined inputs and outputs. The second does not need the first system's entire internal process, but it does need enough context to know what the result means. Was the supplier identity confirmed or merely inferred? Is a payment date absent, or was extraction unsuccessful? Does the returned value refer to this invoice or another record? Each distinction changes what the checking step can do with the answer.\nA catalogue entry for that invented extraction capability could carry a compact account rather than a promise of general document understanding:\nPart of the capability description\tExample declaration\t\nObject being supplied\tA document-extraction workflow, not a trained subnetwork\t\nInput\tA declared family of invoice documents\t\nOutput\tSupplier fields and payment terms, with source locations and unresolved values\t\nRequired context\tDocument identity, language and the selected workflow version\t\nEvaluation question\tWhether supported examples preserve the fields and evidence needed by the payment check\t\nBoundary\tNo authority to approve or execute a payment\t\nConditions of use\tThe workflow's licence and dependencies, without any customer's invoice data\t\nThe next component can now ask a particular question of the output. An absent payment date can remain unresolved rather than masquerade as a zero or an extraction success. Another document layout gives the receiving team a case to test, not a reason to assume the same result. The description supplies a starting point for adoption; the receiving application still has to examine the contribution in its own setting.\nVersioning is a relationship with downstream work\nIf the extraction changes, the checking step may change even when its own code does not. A newer model might recognise more layouts and produce a different format. A revised tool might treat a missing field differently. Moving from a source location to a bare value could leave the payment check without the evidence it used to receive. Versioning connects those changes to the downstream work that depends on them; its value comes from identifying relevant behaviour and requirements.\nThe application needs to identify which capability it used and retain enough context to investigate a regression. Keeping an earlier configuration available can support recovery, provided its dependencies can still be supplied. The practical promise of reuse is less repeated work. Unannounced changes reverse that promise when every consumer has to rediscover the same failure, reconstruct its cause and repair their application separately.\nAdoption gives the description a test\nThe receiving team can now try the capability against a small set of its own permitted documents. Some may match the declared layout; one may use a different currency convention; another may omit a term that the payment check requires. This is where the description becomes useful. It tells the team which result would count as a supported contribution, which case should return an unresolved value and which case needs another adapter or method.\nA failed adoption can improve the shared account. If the consumer had supplied a supported document and lost its source locations, the implementation may need correction. If the document was outside the declared family, a clearer discovery filter could have saved the trial. If the output was faithful but the consumer needed a different question answered, the capability may be working and still be the wrong choice. A network that retains those distinctions can improve discovery without turning every poor fit into a bad rating.\nThis form of adoption is already a useful contribution to the larger ambition. A catalogue can make models, workflows and methods easier to adopt while keeping clear which object is being shared.\nRights travel with the dependency\nA useful configuration may contain a customer's process. A model may carry a licence with particular limits. A dataset may be available for one purpose without permission for another. A standard interface can connect them while their rights remain different. The consumer needs to know which contribution they may use, how they may change it and what must stay with the original owner.\nDAO Studio's platform and partner-product distinction made this concrete: the shared platform and the application made for a partner could have different owners. A reusable mechanism could emerge from service work while the partner's records and particular work remained theirs. That boundary makes a contribution possible without asking people to surrender everything they bring. It also gives the receiving team a clearer account of what they can build upon.\nWhat a network would have to add\nA functioning capability may already be useful to one organisation. A network would need to make something else easier: discovery, comparison, composition, payment, coordination or maintaining a shared account of versions. Contributors need demand; users need capabilities worth adopting. A useful protocol connects those needs to work people can already value, with a reason to participate beyond the hope of a larger network.\nDAOnet explored that protocol ambition through a proposed ledger, memory, observation and execution stack for agents. The wider goal was cumulative capability: one team’s work becoming a useful contribution to another application. A common record could support part of the coordination, while a catalogue and intelligible interfaces could support others. The choice of mechanism should follow the interaction it improves.\nUseful work can accumulate only if its conditions remain intelligible as it travels. A shared capability should save the next person from repeating the mechanism, not force them to repeat the investigation into what it actually means.\nNakamoto's Bitcoin paper states the honest computational-majority assumption behind its history-selection argument. Other consensus systems have their own assumptions; the ledger description here does not make them interchangeable.\nAinsworth, Hayase and Srinivasa, Git Re-Basin: Merging Models modulo Permutation Symmetries, studies aligning model units through permutations and merging in weight space. It is a specific model-merging result, not the arbitrary I/K-capacity operation posed here.\n","url":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"mentions":[{"@id":"https://daostudio.in/daonet/#entity","identifier":"project:daonet","@type":"CreativeWork","name":"DAOnet","subjectOf":[{"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","url":"https://daostudio.in/daonet/"},{"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/"},{"@id":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","@type":"CollectionPage","name":"DAOnet mentions","url":"https://daostudio.in/daonet/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/collections/protocols-and-reuse/","identifier":"collection:dao-studio-protocols-and-reuse","@type":"CollectionPage","name":"Protocols and reuse","url":"https://daostudio.in/collections/protocols-and-reuse/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"Build on another team’s AI capability with its context, version and agreed use understood across applications.","text":"DAOnet\nDAOnet is the DAO Studio protocol design for carrying a capability beyond the application that first made it, as YojnAI composes applications and YOJN Care coordinates response; no marketplace runs. It connects discovery, agreed use and shared execution with feedback that can improve what the next team receives.\nLet useful intelligence accumulate\nShare intelligences, the capabilities agents draw on, and playbooks with their versions and terms understood. Keep the context and results of their use available to the people improving them.\nFrom reuse to improvement\nThe design’s marketplace connects contributors, applications and human feedback.\nExplore the exchange from a contributed workflow to a reviewed improvement.\nPut an invoice reader to work elsewhere\nYour purchasing application could use another team’s invoice workflow. The extracted payment term travels with its source, so your reviewer can check it. Follow that capability into the application and back through review.\nQuestions about DAOnet\nHow does DAOnet differ from YojnAI?\nYojnAI composes an application. DAOnet extends reuse across applications and teams, including the context, execution and transactions around each contribution.\nWhat travels with a capability?\nIts version, conditions of use and the context needed to interpret its results. The shared account connects those to who took part and what happened; people still judge whether the result is useful.\nHow can we obtain DAOnet?\nRawThoughts consulting is the route for the reuse, shared execution or exchange problem you want it to address, with scope, implementation and applicable licensing agreed for the engagement.\n","url":"https://daostudio.in/daonet/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/daonet/#entity","identifier":"project:daonet","@type":"CreativeWork","name":"DAOnet","subjectOf":[{"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","url":"https://daostudio.in/daonet/"},{"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/"},{"@id":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","@type":"CollectionPage","name":"DAOnet mentions","url":"https://daostudio.in/daonet/mentions/"}]}],"mentions":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}],"hasPart":[{"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","@type":"CollectionPage","name":"DAOnet mentions","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"mainEntity":{"@type":"ItemList","numberOfItems":3,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/#article","@type":"Article","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/","identifier":"content:dao-studio-approval-effect","name":"When an approval reaches the effect"}},{"@type":"ListItem","position":2,"item":{"@id":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/#article","@type":"Article","url":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/","identifier":"content:dao-studio-service-to-reusable-capability","name":"Turning service work into reusable capability"}},{"@type":"ListItem","position":3,"item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/#article","@type":"Article","url":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/","identifier":"content:dao-studio-what-a-github-for-intelligence-must-preserve","name":"Some things never change. It’s time they do…"}}],"itemListOrder":"https://schema.org/ItemListOrderDescending"},"description":"Writing across the connected publications that discusses DAOnet without belonging to its help; for how the product works, start with Reuse a capability.","text":"","url":"https://daostudio.in/daonet/mentions/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/daonet/#entity","identifier":"project:daonet","@type":"CreativeWork","name":"DAOnet","subjectOf":[{"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","url":"https://daostudio.in/daonet/"},{"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/"},{"@id":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","@type":"CollectionPage","name":"DAOnet mentions","url":"https://daostudio.in/daonet/mentions/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","headline":"Reuse a capability","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["AI capability reuse","capability versions","invoice extraction","conditions of use","shared execution records"],"mainEntityOfPage":{"@id":"https://daostudio.in/daonet/reuse-a-capability/","@type":"WebPage","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"DAOnet","item":{"@id":"https://daostudio.in/daonet/"}},{"@type":"ListItem","position":2,"name":"Reuse a capability","item":{"@id":"https://daostudio.in/daonet/reuse-a-capability/"}}]}],"relatedLink":["https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/","https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/"]},"description":"Follow an invoice-extraction workflow into another application, keeping its version, evidence and terms of use.","text":"Reuse a capability\nAnother team has an invoice-extraction workflow you would like to use. It returns supplier fields and payment terms, with their locations in the document. Your application could use those results to prepare a payment for review. What must travel with the workflow for you to rely on it?\nDAOnet connects discovery and reuse with execution, continuing memory and a shared account of the exchange. It is paused and remains a protocol design; this worked example explains the exchange rather than a running marketplace. Scope for any work on it is agreed through RawThoughts consulting.\nFind out what the workflow returns\nSuppose an invoice says “payment due 30 days after delivery” but gives no delivery date. The workflow should return the term and its location while leaving the due date unresolved. Your application can then ask for the delivery date. A guessed date would conceal the information the reviewer still needs.\nBefore adopting such a capability, the receiving team needs to understand which documents it supports, what it returns and what must be supplied by the application.\nImportant\nCheck both permissions. The workflow's licence governs reuse of the contribution. Permission to process the customer's invoices is a separate requirement.\nExtraction supplies information for payment review; it does not approve or execute the payment.\nFollow a version into the receiving application\nCompare two hypothetical versions against the same invoice:\nVersion\tReturned result\tConsequence for payment review\t\nA\tThe payment term, its document location and an unresolved due date\tThe reviewer can inspect the term and request the delivery date.\t\nB\tA proposed date without the supporting term or location\tThe reviewer cannot check where the date came from using this result.\t\nVersion B could support more invoice layouts and still break this application's review. The team could keep A while its dependencies remain available, or return the invoice for manual handling. “Latest” does not tell a consumer whether a change is suitable.\nTo investigate a later problem, both teams need to identify the version used, the invoice and the returned output. That lets them distinguish an unsupported document from a changed result or an error in the receiving application. Versioning makes those dependencies visible as the capability travels beyond its first use.\nLet use improve the next contribution\nReusing the workflow can also help improve it. In the design, a coordinating agent called CEO GPT arranges agents that use intelligences, the capabilities agents draw on, and playbooks from the marketplace. Their traces pass through DAOnet to ExpertGPT, the design’s name for the human-feedback service, which informs the next intelligences and playbooks offered for reuse.\nIn the invoice example, repeated confusion between a payment term and a delivery date could become a case for review. A reviewer could identify the distinction, help improve the extraction capability or its playbook, and make a revised version available to the next application. The version comparison still matters: receiving an improvement does not mean accepting it blindly.\nThe same traces connect use with credit for the contributors, although the calculation of credit and payment remains open. Recording a trace cannot itself improve a model or determine what somebody is owed; review and evaluation still have work to do.\nAfter discovery: execution, memory and observability\nFinding the workflow is only the start. Configuration connects it to your application; execution runs the chosen operation, such as extracting invoice terms. Memory keeps the invoice and its context connected across requests, so a later delivery date meets the right term.\nBoth teams also need to examine an attempt and its result. If the connection fails, did the request leave your application, did the workflow run, and did its answer return? Observability makes those events available to investigate.\nDAOnet includes a ledger and smart-contract layer for shared transaction arrangements. Which arrangements need a chain, and which could use existing infrastructure, remains open.\nWhat a shared record leaves to judgment\nA shared record could identify the version used, the agreed use and the operation attempted. The payment reviewer still needs the extraction result and enough evidence to decide whether to approve it. Recording an approval also does not tell the participants whether a payment succeeded. They need an account of the result as well as the decision.\nThe choice of infrastructure follows that coordination problem. A common ledger could help participants compare their accounts of an exchange. It cannot supply a missing delivery date, judge an invoice or make an unsupported extraction reliable.\nReuse within one application and across applications\nYojnAI approaches reuse within an application by arranging models, tools and checks for a particular operation. DAOnet's protocol extends reuse across applications and teams. Its practical question is whether sharing a capability saves the receiving team work while preserving what it needs to understand and review the result.\n","url":"https://daostudio.in/daonet/reuse-a-capability/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"copyrightHolder":[{"@id":"https://daostudio.in/#organization"}],"about":[{"@id":"https://daostudio.in/daonet/#entity","identifier":"project:daonet","@type":"CreativeWork","name":"DAOnet","subjectOf":[{"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","url":"https://daostudio.in/daonet/"},{"@id":"https://daostudio.in/daonet/reuse-a-capability/#article","identifier":"content:dao-studio-daonet-docs","@type":"Article","name":"Reuse a capability","url":"https://daostudio.in/daonet/reuse-a-capability/"},{"@id":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","@type":"CollectionPage","name":"DAOnet mentions","url":"https://daostudio.in/daonet/mentions/"}]}],"mentions":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","@type":"CollectionPage","name":"DAOnet","url":"https://daostudio.in/daonet/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/privacy/","identifier":"content:dao-studio-privacy","@type":"WebPage","name":"Privacy notice","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"Website hosting, email contact, reading preferences and external reading assistance for DAO Studio.","text":"Privacy notice\nDAO Studio Private Limited (DSPL) is responsible for deciding how personal data is used on daostudio.in. DSPL publishes and operates the website. This notice explains the information handled when you read the website or use its contact and reading tools.\nVisiting the website\nGitHub Pages hosts this publication. Serving a page involves connection information, including your IP address and the page requested. GitHub logs visitors' IP addresses for security, including when a visitor is not signed in. GitHub handles that information under its privacy statement.\nSearch runs in your browser against the website's own index, and the website sends your query to no service. The query is kept in the search page's address, so like any page address it can reach GitHub with your browser's requests, appear in your browser history and travel with the address if you share it.\nIf your browser has an assistant that supports it, each page offers that assistant two read-only tools: the text of the page you are reading and the same in-browser search. They work on what the page already shows and send nothing to us; what the assistant does with what it reads follows its provider's terms.\nContacting us\nA contact link opens a prepared message in your own email application. The website does not receive or store the message as a form submission. If you choose to send it, your email service and the recipient's mail service handle the correspondence. The website's general contact link is addressed to RawThoughts Enterprises Private Limited (RTEPL), a separate company that handles DAO Studio's business enquiries. Any professional work that follows has its own correspondence and agreement.\nFor privacy questions, a grievance or a request concerning your personal data, write to DSPL at info@daostudio.in. Include enough information to identify the request, but do not send passwords or unnecessary identity documents. We respond within 30 days and may ask for proportionate verification before disclosing or changing personal data.\nReading preferences\nThe display settings remember your colour and motion choices in your browser on this device. You can change them in Settings or clear the website's stored data through your browser. These preferences are used to display the page; they stay in your browser and are not sent to us.\nAsking about a passage\nWhen you select text and choose a reading assistant, the link opens that provider with the selected passage, nearby context, the section and article titles, and the article and publication addresses. The passage is limited to 4,096 characters and the nearby context to 1,024. Selecting text alone prepares the link in your browser; choosing the provider sends it there.\nThe assistant is an external service. The request is included in its link, so it can also appear in your browser history. The provider's own terms, privacy policy and your account settings govern what it does with the request and any conversation that follows. Reading the article does not require using an assistant.\nHow long information is kept\nWe keep no record of visits on our own systems; GitHub keeps its connection logs for the periods its policy sets. Correspondence you send is kept for as long as the matter it concerns needs it and as the law requires.\nSecurity and incidents\nThis website holds no accounts and receives no form submissions. If a personal-data breach affects you, we inform you and the authorities as applicable law requires.\nYour choices\nFollowing another external link takes you to that service under its own data practices. Links to RawThoughts services lead to rawthoughts.in, which RTEPL publishes under its own privacy notice.\nYou may ask us about your data, request correction or deletion, withdraw consent or raise a concern using the contact above. Requests are handled under applicable law; information needed to comply with a legal obligation or resolve a dispute may need to be kept. Withdrawing consent does not undo processing that has already occurred lawfully.\nChanges to the website's data practices will be reflected in this notice. A new optional use that requires consent will ask for that consent rather than treating continued reading as agreement.\nLast reviewed on 22 November 2026 by DAO Studio Private Limited.\n","url":"https://daostudio.in/privacy/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/search/","identifier":"content:dao-studio-search","@type":"CollectionPage","name":"Search","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"mainEntity":{"@type":"ItemList","numberOfItems":15,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/","@type":"CollectionPage","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/","identifier":"journey:dao-studio-judgment-before-action","name":"A court before the consequence"}},{"@type":"ListItem","position":2,"item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/#article","@type":"Article","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/a-precognition-court-for-ai/","identifier":"content:dao-studio-a-ledger-cannot-decide-what-is-legitimate","name":"A precognition court for AI"}},{"@type":"ListItem","position":3,"item":{"@id":"https://daostudio.in/about/","@type":"AboutPage","url":"https://daostudio.in/about/","identifier":"content:dao-studio-about","name":"About DAO Studio"}},{"@type":"ListItem","position":4,"item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/#article","@type":"TechArticle","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/","identifier":"content:dao-studio-agent-playbook-and-application","name":"An agent, a playbook and an application"}},{"@type":"ListItem","position":5,"item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/#article","@type":"Article","url":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/","identifier":"content:dao-studio-an-interface-with-room-to-act","name":"An interface with room to act"}},{"@type":"ListItem","position":6,"item":{"@id":"https://daostudio.in/blog/","@type":"CollectionPage","url":"https://daostudio.in/blog/","identifier":"content:dao-studio-articles","name":"Blog"}},{"@type":"ListItem","position":7,"item":{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","@type":"TechArticle","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/","identifier":"content:dao-studio-yojnai-docs","name":"Compose, inspect and improve an application"}},{"@type":"ListItem","position":8,"item":{"@id":"https://daostudio.in/collections/composing-ai-work/","@type":"CollectionPage","url":"https://daostudio.in/collections/composing-ai-work/","identifier":"collection:dao-studio-composing-ai-work","name":"Composing AI work"}},{"@type":"ListItem","position":9,"item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/","@type":"CollectionPage","url":"https://daostudio.in/collections/coordinating-emergencies/","identifier":"collection:dao-studio-coordinating-emergencies","name":"Coordinating emergencies"}},{"@type":"ListItem","position":10,"item":{"@id":"https://daostudio.in/","@type":"WebPage","url":"https://daostudio.in/","identifier":"content:dao-studio-home","name":"DAO Studio"}},{"@type":"ListItem","position":11,"item":{"@id":"https://daostudio.in/daonet/","@type":"CollectionPage","url":"https://daostudio.in/daonet/","identifier":"content:dao-studio-daonet","name":"DAOnet"}},{"@type":"ListItem","position":12,"item":{"@id":"https://daostudio.in/daonet/mentions/","@type":"CollectionPage","url":"https://daostudio.in/daonet/mentions/","identifier":"content:daonet-mentions","name":"DAOnet mentions"}},{"@type":"ListItem","position":13,"item":{"@id":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/#article","@type":"Article","url":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/","identifier":"content:dao-studio-less-interface-more-visible-control","name":"Evolution of AI, and its future in B2B"}},{"@type":"ListItem","position":14,"item":{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","@type":"Article","url":"https://daostudio.in/yojn-care/follow-an-incident/","identifier":"content:dao-studio-yojn-care-docs","name":"Follow an incident"}},{"@type":"ListItem","position":15,"item":{"@id":"https://daostudio.in/blog/follow-the-data/#article","@type":"TechArticle","url":"https://daostudio.in/blog/follow-the-data/","identifier":"content:dao-studio-self-hosted-is-not-a-data-map","name":"Follow the data, not the deployment label"}}]},"description":"Find pages, articles and collections from DAO Studio.","text":"","url":"https://daostudio.in/search/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/terms/","identifier":"content:dao-studio-terms","@type":"WebPage","name":"Terms of use","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"Use and reuse of DAO Studio and contact with the publisher.","text":"Terms of use\nDAO Studio is published and operated by DAO Studio Private Limited (DSPL). These terms concern your use of daostudio.in and every subdomain of it.\nReading and reusing material\nUnless a page states its own licence, daostudio.in is not openly licensed. You may read it, link to its pages and quote passages from it with attribution: name the author or publication and link to the page you quote. We permit that use, and it leaves untouched any wider right you have under fair dealing (section 52 of India's Copyright Act, 1957) or fair use elsewhere. The permission covers accurate quotation only; it does not cover misquoting the material or quoting it out of context so that it says something it does not. Reproducing the material without attribution, or presenting it as your own, is not permitted.\nTraining AI models on this material is not permitted, whether it is collected from this website, its subdomains or any other copy, and training crawlers are refused. Search engines and answer systems that link to the pages and cite them remain welcome; only training is refused. This reservation is also our opt-out from text and data mining wherever the law provides one. Each website and subdomain carries it in its robots.txt and a machine-readable reservation wherever its host lets us publish them; where a host does not, this page still applies. These terms do not withdraw permissions granted by a licence or change a third party's rights.\nFor other copying, adaptation or redistribution, follow the licence attached to the page, asset or source, or ask us or the rights holder named on the item. Attribution alone does not replace permission.\nAuthors, contributors and third parties retain the rights attributed to them. Quotations, translations, images and software do not acquire a common licence merely by appearing on this website. A software repository's licence governs that software, not all the prose or images published here.\nThe scope of the publication\nThe website includes company and product history. A description of past work is not an offer of an available product or emergency service. Consulting, licensing and delivery arrangements require their own agreement with the named counterparty.\nWe aim to keep the material accurate and correct errors brought to our attention. Sources, methods and circumstances can change; a dated account concerns the setting it describes. You remain responsible for assessing whether material is suitable for your circumstances and for seeking qualified advice where needed.\nResponsible use\nDo not use the website to infringe another person's rights, expose confidential information, impersonate someone, interfere with its operation or attempt unauthorised access.\nExternal websites and services have their own terms. A reference is not an assurance of their accuracy, security or continued availability.\nAvailability and responsibility\nThe publication is provided as information. We do not promise uninterrupted access or that every example will suit a particular purpose. To the extent permitted by applicable law, we make no warranty of fitness for your use and are not responsible for loss arising from reliance on the material or interruption of access. Nothing here excludes a responsibility or remedy that the law does not allow us to exclude.\nPrivacy and contact\nThe privacy notice explains the information handled by this publication's website and reading tools. A new use requiring consent will ask for it; continued reading is not agreement to that use.\nFor a correction, permission request or concern about these terms, write to info@daostudio.in. Please identify the page and the issue so we can respond.\nGoverning law\nIndian law governs these terms. Subject to mandatory law and any jurisdiction that cannot lawfully be excluded, disputes concerning use of the website fall within the jurisdiction of the competent courts in Lucknow. These terms do not replace a separate contract, licence or statutory right.\n","url":"https://daostudio.in/terms/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"Connect personal requests, camera evidence and human review so an incident can become a continuing response.","text":"YOJN Care\nYOJN Care is the DAO Studio product for emergency response, beside YojnAI and DAOnet. It connects personal requests, existing cameras and human response for homes, shops and neighbourhoods. The product is paused, and YOJN Care is not a live emergency or dispatch service.\nIf you need help now, call your local emergency number.\nFrom an alert to someone taking it on\nSee what happened, who has been contacted and who is handling it, without piecing the incident together again.\nKeep the incident together\nA shop's camera views and an unanswered owner call stay together when another operator takes over. Follow the incident.\nBuilt for the person asking and the person reviewing\nOne-handed requests\nSOS and High Alert with a clear view of what happens next. The personal interface.\nExisting cameras\nCamera evidence, reference views and site instructions brought into the same review.\nShared response\nConnect owners, neighbours and monitoring teams while keeping responsibility visible.\nQuestions about YOJN Care\nWho is YOJN Care for?\nHomes, shops and neighbourhoods, and the monitoring teams who review their incidents.\nDoes an alert mean help has been dispatched?\nNo. Raising an alert, reviewing it, dispatching help and arriving are separate steps. Follow an incident explains the response design.\nHow can we obtain YOJN Care?\nYOJN Care remains available through RawThoughts consulting. Bring the response workflow you need. Scope, delivery and licensing are agreed for the engagement.\n","url":"https://daostudio.in/yojn-care/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}],"hasPart":[{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/personal-requests/#article","identifier":"content:yojn-care-personal-requests","@type":"Article","name":"Understand a personal request","url":"https://daostudio.in/yojn-care/personal-requests/"},{"@id":"https://daostudio.in/yojn-care/review-and-handover/#article","identifier":"content:yojn-care-review-and-handover","@type":"Article","name":"Review an incident and carry it onward","url":"https://daostudio.in/yojn-care/review-and-handover/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","headline":"Follow an incident","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["incident continuity","personal SOS","human review","response handover"],"mainEntityOfPage":{"@id":"https://daostudio.in/yojn-care/follow-an-incident/","@type":"WebPage","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"YOJN Care","item":{"@id":"https://daostudio.in/yojn-care/"}},{"@type":"ListItem","position":2,"name":"Follow an incident","item":{"@id":"https://daostudio.in/yojn-care/follow-an-incident/"}}]}]},"description":"Follow a shop incident from a camera alert or personal SOS through review and handover.","text":"Follow an incident\nYOJN Care is not a live emergency or dispatch service; this guide explains its response design. If you need help now, call your local emergency number.\nImagine a shop camera detecting a person after closing time. A second camera supplies another view. An operator calls the owner to ask whether the person is authorised staff, but the shift ends before the owner replies. The next operator needs both views, the question already asked and the work still waiting. Starting again from the latest alert would lose part of the incident.\nYOJN Care brings those observations and actions together, connecting the person asking for help with their community, monitoring operators and authorised responders.\nContinue the incident, not just the latest alert\nThe operator compares the camera frames with the shop's reference view and instructions. A person in the image might be authorised staff; the pictures alone do not settle it. The operator records the call and the unanswered question. Later notifications add evidence to this incident instead of starting another investigation of the same event.\nA neighbour may have opened the alert without agreeing to investigate. The incoming operator needs to know who has actually agreed to continue the review. Opening an alert, reviewing it and dispatching help therefore need separate states. The monitoring guide follows this handover, and Who carries the incident? explores the responsibility behind it.\nSomeone can ask for help directly\nSOS begins with a person asking for help. It needs no camera image to make that request meaningful. High Alert raises a concern for assessment, as does an automatic detection; the reviewer needs to know which kind of request arrived.\nBoth personal actions are accessible with one hand. Groups, location sharing, camera sessions and incident evidence can give others context. After the gesture, the person needs to see whether the request is still sending, has reached the service or is being handled. Understand a personal request follows those states and what happens if the person corrects or cancels it.\nGive the reviewer a usable view\nMonitoring a shop starts with its existing cameras, the hours when nobody should be there and the owner's instructions. A computer at the premises, or compatible camera software, supplies detections and media for review. The installation, connection and cameras need continuing maintenance; an old image cannot answer whether somebody is still inside.\nThe operator also needs the earlier handling. An old image and an unanswered call leave different questions open: one needs a current view, the other an answer from the owner. The evidence path follows those inputs from the premises to the reviewer.\nKeep someone available to continue\nSharing monitoring across premises and involving the community can make coverage more affordable. Grouping related observations also avoids asking several people to investigate the same thing from scratch. But somebody still needs to be available when a case arrives, and an unanswered case must remain visible while they work on it.\nA response service needs agreed staffing, coverage, maintenance and authorised response arrangements. Emergency-service integration requires those services to participate; it cannot be supplied by a button in the application. Staffing and maintenance explains what continuing that coverage involves.\n","url":"https://daostudio.in/yojn-care/follow-an-incident/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"copyrightHolder":[{"@id":"https://daostudio.in/#organization"}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"mainEntity":{"@type":"ItemList","numberOfItems":8,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://getharsh.in/collections/building-products-and-teams/what-remains-when-an-experiment-ends/#article","@type":"BlogPosting","url":"https://getharsh.in/collections/building-products-and-teams/what-remains-when-an-experiment-ends/","identifier":"content:getharsh-what-remains-when-an-experiment-ends","name":"What remains when an experiment ends"}},{"@type":"ListItem","position":2,"item":{"@id":"https://getharsh.in/collections/building-products-and-teams/the-work-that-can-travel/#article","@type":"Article","url":"https://getharsh.in/collections/building-products-and-teams/the-work-that-can-travel/","identifier":"content:getharsh-the-work-that-can-travel","name":"The work that can travel"}},{"@type":"ListItem","position":3,"item":{"@id":"https://getharsh.in/collections/building-products-and-teams/a-career-through-problems/the-customer-changes-the-system/#article","@type":"BlogPosting","url":"https://getharsh.in/collections/building-products-and-teams/a-career-through-problems/the-customer-changes-the-system/","identifier":"content:getharsh-the-customer-changes-the-system","name":"The customer changes the system"}},{"@type":"ListItem","position":4,"item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/#article","@type":"Article","url":"https://daostudio.in/collections/coordinating-emergencies/the-cost-of-continuing-response/","identifier":"content:dao-studio-the-cost-of-continuing-response","name":"The cost of continuing response"}},{"@type":"ListItem","position":5,"item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/#article","@type":"Article","url":"https://daostudio.in/collections/coordinating-emergencies/the-cases-that-are-still-waiting/","identifier":"content:dao-studio-pending-is-not-noise","name":"The cases that are still waiting"}},{"@type":"ListItem","position":6,"item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/#article","@type":"Article","url":"https://daostudio.in/collections/coordinating-emergencies/an-interface-with-room-to-act/","identifier":"content:dao-studio-an-interface-with-room-to-act","name":"An interface with room to act"}},{"@type":"ListItem","position":7,"item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/#article","@type":"Article","url":"https://daostudio.in/collections/coordinating-emergencies/who-carries-the-incident/","identifier":"content:dao-studio-detection-is-not-dispatch","name":"Who carries the incident?"}},{"@type":"ListItem","position":8,"item":{"@id":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/#article","@type":"TechArticle","url":"https://daostudio.in/collections/coordinating-emergencies/the-evidence-path/","identifier":"content:dao-studio-the-evidence-path","name":"The evidence path"}}],"itemListOrder":"https://schema.org/ItemListOrderDescending"},"description":"Writing across the connected publications that discusses YOJN Care without belonging to its help; for how the product works, start with Follow an incident.","text":"","url":"https://daostudio.in/yojn-care/mentions/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/yojn-care/personal-requests/#article","identifier":"content:yojn-care-personal-requests","@type":"Article","name":"Understand a personal request","headline":"Understand a personal request","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["SOS and High Alert","request received","accidental activation","response acceptance"],"mainEntityOfPage":{"@id":"https://daostudio.in/yojn-care/personal-requests/","@type":"WebPage","name":"Understand a personal request","url":"https://daostudio.in/yojn-care/personal-requests/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"YOJN Care","item":{"@id":"https://daostudio.in/yojn-care/"}},{"@type":"ListItem","position":2,"name":"Understand a personal request","item":{"@id":"https://daostudio.in/yojn-care/personal-requests/"}}]}]},"description":"Follow an SOS from sending and receipt to someone handling it, including what happens after a correction.","text":"Understand a personal request\nYOJN Care is not a live emergency or dispatch service; this guide explains its personal interface. If you need help now, call your local emergency number.\nYou have pressed SOS. Did the request reach anyone, and has someone agreed to help? With one hand occupied and little attention to spare, you need to understand both. A moving indicator or a list of contacts cannot answer the second question.\nSOS and High Alert start different reviews\nSOS is a deliberate request for help unless activated accidentally. High Alert raises a concern for further assessment. The reviewer needs to know which arrived before deciding what to check; whether anyone has agreed to respond is a later question.\nThe emergency action stays visible. Distinct one-handed gestures for SOS and High Alert open a dedicated screen, where the person can follow the request. Groups, shared location and incident evidence help others understand the situation.\nA request can begin without a camera view\nA person asking for help should not need a camera image to make the request meaningful. A camera detection begins with an observation that needs interpretation. Care keeps these origins distinct, then follows what happens to each request:\nState\tWhat the person needs to know\t\nSending\tThe application is trying to reach the service\t\nReceived\tThe request reached the service, but someone may still need to pick it up\t\nBeing handled\tSomeone agreed to review or respond; dispatch and arrival are separate events\t\nCorrection requested\tA change or withdrawal needs to reach anyone already handling the incident\t\nThese distinctions matter even when a notification says “delivered” or “read”. A delivered message does not mean someone has taken it on. An opened message does not mean help is on the way.\nWhen connectivity or setup blocks a request\nIf connectivity, a permission or incomplete setup prevents sending, the person needs to see that particular problem and reach the missing input or relevant phone setting. An urgent request should not send them through an unrelated administrative checklist.\nThe people view orders requests by urgency: unattended SOS, active SOS, unattended High Alert, then active High Alert. Family, friend and co-worker ordering applies within each group. A close relationship does not put a less urgent event ahead of someone still waiting for help. Nor does familiarity establish availability: who was notified and who agreed to act remain separate.\nA correction needs to reach the continuing incident\nConsider an accidental SOS. Cancelling before it is sent differs from correcting it after the service receives it. Someone may already be acting on the second request. Changing the local screen is not enough: the correction needs to reach those people, and the person cancelling needs to see whether it arrived.\nCare's SOS flow carries the termination to the community separately from acknowledgement. The request's correction also needs to survive reconnection, so a delayed message cannot restore the earlier request without its update.\nAn interface with room to act examines these interaction choices. The monitor's view follows what happens when the request reaches another person.\n","url":"https://daostudio.in/yojn-care/personal-requests/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"copyrightHolder":[{"@id":"https://daostudio.in/#organization"}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/yojn-care/review-and-handover/#article","identifier":"content:yojn-care-review-and-handover","@type":"Article","name":"Review an incident and carry it onward","headline":"Review an incident and carry it onward","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["camera evidence freshness","site configuration","operator review","responsibility handover"],"mainEntityOfPage":{"@id":"https://daostudio.in/yojn-care/review-and-handover/","@type":"WebPage","name":"Review an incident and carry it onward","url":"https://daostudio.in/yojn-care/review-and-handover/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"YOJN Care","item":{"@id":"https://daostudio.in/yojn-care/"}},{"@type":"ListItem","position":2,"name":"Review an incident and carry it onward","item":{"@id":"https://daostudio.in/yojn-care/review-and-handover/"}}]}]},"description":"Keep the evidence, calls and unanswered questions together when another operator takes over an incident.","text":"Review an incident and carry it onward\nYOJN Care is not a live emergency or dispatch service; this guide explains its monitoring workflow. If you need help now, call your local emergency number.\nYou take over a shop incident from another operator. Two camera views are attached, the owner has been called and a reply is still awaited. Can you continue from there, or must you investigate everything again? Care brings the site's instructions, images, personal requests and earlier review together so the next person can see what happened and what remains to do.\nBegin with the evidence actually available\nA person appears in the shop during its unattended hours. The owner may recognise authorised staff; an operator may need a reference view or the owner's explanation before deciding what the image means. The detection begins that review.\nRelated frames and notifications belong together. One camera may show something another misses, and a later frame may change the interpretation. A judgment on one image should not close every observation in the incident.\nA deliberate SOS has a different starting point: somebody asked for help. It can need attention even when no camera shows the situation. The reviewer needs to recognise that origin rather than see every alert as another camera-detection task.\nCheck whether the view can support the question\nSuppose the shop camera appears connected, but its picture is old. It cannot tell you whether someone is still inside. You need a current view or an answer from the owner before drawing that conclusion.\nCapture time and upload time therefore matter separately. So do unattended hours, camera placement, contact details and the site's instructions. Missing or unusable evidence needs to be apparent. The evidence path explains how keeping those inputs usable sustains the coverage.\nDecide what the image means, then carry the answer onward\nThe review compares the frame with the reference view and the owner's instructions, distinguishing crime, suspicion, non-suspicion and a false positive. Selecting an answer and forwarding it are separate actions: the reviewer can reset an answer or leave it incomplete. Using the siren or speaker is separate too, with one person in control at a time.\nA case cannot wait forever for somebody to pick it up. Care's automatic-detection workflow gives the operator a pickup allowance, then passes an unattended case to the manager and, after another timeout, to the community as suspicious. Loading evidence and calling the owner can extend handling time. The state and clock example sets out the allowances. They concern review, not the time for help to arrive.\nTell the next operator what still needs doing\nIn the shop incident, “owner called” is not enough. The handover needs to say that the reply is still awaited, which two views were examined and whether more camera notifications have arrived. The new operator can then continue without repeating the investigation or assuming the owner has answered.\nThe handover also needs someone who agrees to continue. A community contact may be unavailable, and an operator who can review images may have no authority to dispatch help. Opening an alert establishes neither commitment.\nAn authorised responder may act outside the interface. Without their update, the outcome remains uncertain. Closing a shift or moving the case to another queue should not turn that uncertainty into a completed response. Who carries the incident? develops this responsibility; Follow an incident connects the review to the personal application and the service arrangements it needs.\n","url":"https://daostudio.in/yojn-care/review-and-handover/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"copyrightHolder":[{"@id":"https://daostudio.in/#organization"}],"about":[{"@id":"https://daostudio.in/yojn-care/#entity","identifier":"project:yojn-care","@type":"SoftwareApplication","name":"YOJN Care","subjectOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"},{"@id":"https://daostudio.in/yojn-care/follow-an-incident/#article","identifier":"content:dao-studio-yojn-care-docs","@type":"Article","name":"Follow an incident","url":"https://daostudio.in/yojn-care/follow-an-incident/"},{"@id":"https://daostudio.in/yojn-care/mentions/","identifier":"content:yojn-care-mentions","@type":"CollectionPage","name":"YOJN Care mentions","url":"https://daostudio.in/yojn-care/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/yojn-care/","identifier":"content:dao-studio-yojn-care","@type":"CollectionPage","name":"YOJN Care","url":"https://daostudio.in/yojn-care/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"description":"Compose AI applications people can inspect, guide and improve, connecting models and tools to real organisational work.","text":"YojnAI\nYojnAI is the DAO Studio product for composing AI applications, between YOJN Care’s response work and DAOnet’s reuse across teams. It works between the model call and the final answer, moving beyond “0 or 1”: inspect an agent’s result, supply the context it lacks and continue from there. YojnAI is paused as a product.\nBuild the application around the work\nCombine models and tools, connect them to the organisation’s records, and give the people who know the operation a way to inspect and improve the result.\nAn application, a playbook and an agent\nThe organisation’s context\nIts records, services, people and permitted access.\nApplication configuration\nConnect the playbooks to the organisation’s work.\nPlaybook\nArrange agents and checks into a workflow.\nAgent\nCombine models and tools for one contribution people can inspect.\nKeep a delivery date while a payment term is corrected\nYour team’s purchasing assistant can keep a delivery date while a reviewer corrects a payment term. Follow the purchase request to see how intermediate results let both contributions meet.\nQuestions about YojnAI\nWho is YojnAI for?\nTeams building AI applications and the people who know the operation those applications serve. Low-code composition lets builders reuse work; traces and feedback let operators help improve it.\nDoes feedback change the application immediately?\nNo. The team evaluates a candidate improvement and chooses which version to use. Review a disputed answer follows that choice.\nWhere has YojnAI been used?\nPilots in investment banking, operations and the CFO office covered invoices, agreements and research calculations. The partner companies own those applications. The deployment account explains the data paths and reported model results with their limits.\nHow can we obtain YojnAI?\nYojnAI remains available through RawThoughts consulting. Each engagement sets the application scope, integration, deployment and licensing for your use.\n","url":"https://daostudio.in/yojnai/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}],"hasPart":[{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/review-a-disputed-answer/#article","identifier":"content:yojnai-review-a-disputed-answer","@type":"TechArticle","name":"Review a disputed answer","url":"https://daostudio.in/yojnai/review-a-disputed-answer/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","headline":"Compose, inspect and improve an application","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["application composition","agents and playbooks","intermediate state","feedback projects","application versions"],"mainEntityOfPage":{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/","@type":"WebPage","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"YojnAI","item":{"@id":"https://daostudio.in/yojnai/"}},{"@type":"ListItem","position":2,"name":"Compose, inspect and improve an application","item":{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/"}}]}],"relatedLink":["https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/"]},"description":"Follow a purchase request through agents and playbooks, and see where people can supply context or correct a result.","text":"Compose, inspect and improve an application\nYour purchasing assistant has found the agreement and extracted its payment terms, but it is waiting for a delivery date. A reviewer could already check the terms while the customer supplies the date. Why should both wait for the assistant's final answer?\nYojnAI lets teams participate in that unfinished work, connecting models, tools and checks with intermediate results people can inspect. This hypothetical purchase follows the application design from a source document to a reviewed change.\nYojnAI is paused as a product. Delivery and integration remain available through RawThoughts consulting; this guide explains the application model.\nGive each part of the purchase a job\nAn agent combines models and tools for one contribution, such as retrieving the agreement or extracting its payment terms. A playbook arranges agents and checks into a workflow: retrieve the agreement, extract the terms, check that each term has a source, then prepare the draft once the missing date arrives.\nAn application configuration connects that playbook to the customer's actual agreements, services and permitted access. A reviewer's knowledge can become a check where it is needed, rather than another instruction added to one large prompt. Configuring these apps, checks, tools, agents and models is the Create part of YojnAI.\nA financial calculation needs the same care: named inputs, operations and conditional branches keep the chosen periods and definitions visible. The composition account follows those choices.\nContinue without repeating completed work\nAn application that receives only a finished answer has little opportunity to contribute while the work is running. Agent-level callbacks and saved intermediate state give another person or component a place to inspect a result, supply missing context and continue.\nIn the purchase example, a reviewer could examine the extracted terms while the customer supplied the delivery date. Keeping the completed extraction would avoid running it again just to incorporate that date. The important distinction is between the work already available and the dependency still waiting for an answer.\nAdd a customer’s date and a reviewer’s correction without redoing work\nThe customer’s date and the reviewer’s correction should enter without discarding completed work:\nPart of the request\tAfter extraction\tCustomer supplies a date\tReviewer corrects a term\t\nSupplier and source\tAvailable\tUnchanged\tStill useful if the same source applies\t\nPayment term\tAvailable, awaiting review\tUnchanged\tUse the reviewed value\t\nDelivery date\tMissing\tUse the supplied date\tUnchanged\t\nPurchase draft\tWaiting for the date\tReady to assemble\tReconsider the part using the term\t\nOrder placement\tNot performed\tNot performed\tNot performed\t\nThe date can unblock a draft without repeating extraction. A corrected term can change the draft without losing that date. An older response arriving after the correction must remain an earlier result; using it as the current term could undo the review. The composition account develops this example, including concurrent work.\nFind the step that needs to change\nSuppose the reviewer disputes the payment term. The final answer alone cannot say whether the assistant read the wrong agreement, used an old version or extracted the wrong value. An execution trace connects the run to its steps, inputs, outputs and metadata, giving the reviewer somewhere to look. Review a disputed answer follows this investigation.\nStart the review with the application and version, then the trace and the particular step being judged. A feedback project keeps assessments together, so reviewers can compare a proposed change with its results. Access roles determine who can review; expertise weights determine how their judgments contribute to evaluation. Permission to submit feedback and knowledge of a financial calculation answer different questions.\nThis assessment and feedback work belongs to Improve. An administrator versions the feedback project and starts an improvement job. The team then inspects the result and chooses whether to use it. One-click reversion gives them a way back if the new version proves unsuitable.\nChoose which version people use\nDeploy connects an application configuration to customer requests through versions, runs and A/B tests. A correction can inform a candidate version while people continue using the current one. The team can evaluate the change before choosing it.\nSeveral versions of one configuration count as one service instance. Changing a model or check does not itself create another instance.\nKnow where the agreement and feedback go\nThe purchasing team also needs to know who may read the agreement and which services receive it. Comply organises users, projects and objectives around access and the exchange of personal information. Partner applications keep their own owners.\nImportant\nMap the whole deployment. Customer-side integrations and databases connected to gateways, services and caches hosted by DAO Studio. Installing the integration on the customer’s infrastructure did not keep every request, trace or piece of feedback there. Follow the data, not the deployment label explains the different paths.\nThe people who know the operation remain essential. They can identify an exception, correct a source or explain why a plausible answer is unsuitable. Composition gives that knowledge a useful place: a source, a check, a reviewed interpretation or a changed workflow. The organisation around the AI explores how those contributions fit the team's work.\n","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"copyrightHolder":[{"@id":"https://daostudio.in/#organization"}],"about":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"mainEntity":{"@type":"ItemList","numberOfItems":13,"itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/#article","@type":"Article","url":"https://daostudio.in/collections/protocols-and-reuse/a-court-before-the-consequence/when-an-approval-reaches-the-effect/","identifier":"content:dao-studio-approval-effect","name":"When an approval reaches the effect"}},{"@type":"ListItem","position":2,"item":{"@id":"https://getharsh.in/collections/building-products-and-teams/a-career-through-problems/making-intelligence-usable/#article","@type":"BlogPosting","url":"https://getharsh.in/collections/building-products-and-teams/a-career-through-problems/making-intelligence-usable/","identifier":"content:getharsh-making-intelligence-usable","name":"Making intelligence usable"}},{"@type":"ListItem","position":3,"item":{"@id":"https://getharsh.in/collections/building-products-and-teams/the-work-that-can-travel/#article","@type":"Article","url":"https://getharsh.in/collections/building-products-and-teams/the-work-that-can-travel/","identifier":"content:getharsh-the-work-that-can-travel","name":"The work that can travel"}},{"@type":"ListItem","position":4,"item":{"@id":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/#article","@type":"Article","url":"https://daostudio.in/blog/turning-service-work-into-reusable-capability/","identifier":"content:dao-studio-service-to-reusable-capability","name":"Turning service work into reusable capability"}},{"@type":"ListItem","position":5,"item":{"@id":"https://rawthoughts.in/blog/ai-101/#article","@type":"TechArticle","url":"https://rawthoughts.in/blog/ai-101/","identifier":"content:rawthoughts-ai-101","name":"AI 101"}},{"@type":"ListItem","position":6,"item":{"@id":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/#article","@type":"Article","url":"https://daostudio.in/collections/protocols-and-reuse/some-things-never-change/","identifier":"content:dao-studio-what-a-github-for-intelligence-must-preserve","name":"Some things never change. It’s time they do…"}},{"@type":"ListItem","position":7,"item":{"@id":"https://daostudio.in/blog/follow-the-data/#article","@type":"TechArticle","url":"https://daostudio.in/blog/follow-the-data/","identifier":"content:dao-studio-self-hosted-is-not-a-data-map","name":"Follow the data, not the deployment label"}},{"@type":"ListItem","position":8,"item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/#article","@type":"Article","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/from-feedback-to-a-version-worth-using/","identifier":"content:dao-studio-feedback-is-not-a-deployment-instruction","name":"From feedback to a version worth using"}},{"@type":"ListItem","position":9,"item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/reading-the-work-behind-an-answer/#article","@type":"TechArticle","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/reading-the-work-behind-an-answer/","identifier":"content:dao-studio-a-trace-is-not-an-explanation","name":"Reading the work behind an answer"}},{"@type":"ListItem","position":10,"item":{"@id":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/#article","@type":"TechArticle","url":"https://daostudio.in/collections/composing-ai-work/from-composition-to-a-deliberate-change/agent-playbook-and-application/","identifier":"content:dao-studio-agent-playbook-and-application","name":"An agent, a playbook and an application"}},{"@type":"ListItem","position":11,"item":{"@id":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/#article","@type":"Article","url":"https://daostudio.in/blog/evolution-of-ai-and-its-future-in-b2b/","identifier":"content:dao-studio-less-interface-more-visible-control","name":"Evolution of AI, and its future in B2B"}},{"@type":"ListItem","position":12,"item":{"@id":"https://daostudio.in/blog/the-organisation-around-the-ai/#article","@type":"Article","url":"https://daostudio.in/blog/the-organisation-around-the-ai/","identifier":"content:dao-studio-the-organisation-around-the-ai","name":"The organisation around the AI"}},{"@type":"ListItem","position":13,"item":{"@id":"https://getharsh.in/blog/navigating-the-feedback-loop/#article","@type":"BlogPosting","url":"https://getharsh.in/blog/navigating-the-feedback-loop/","identifier":"content:getharsh-navigating-the-feedback-loop","name":"Navigating the feedback loop"}}],"itemListOrder":"https://schema.org/ItemListOrderDescending"},"description":"Writing across the connected publications that discusses YojnAI without belonging to its help; for how the product works, start with Compose, inspect and improve an application.","text":"","url":"https://daostudio.in/yojnai/mentions/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"author":[{"@id":"https://getharsh.in/#person","identifier":"person:harsh","@type":"Person","name":"Harsh Joshi","url":"https://getharsh.in/","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}]}],"about":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/yojnai/review-a-disputed-answer/#article","identifier":"content:yojnai-review-a-disputed-answer","@type":"TechArticle","name":"Review a disputed answer","headline":"Review a disputed answer","creativeWorkStatus":"published","inLanguage":"en","usageInfo":{"@id":"https://daostudio.in/terms/"},"keywords":["source version selection","execution trace review","dependency corrections","candidate evaluation"],"mainEntityOfPage":{"@id":"https://daostudio.in/yojnai/review-a-disputed-answer/","@type":"WebPage","name":"Review a disputed answer","url":"https://daostudio.in/yojnai/review-a-disputed-answer/","breadcrumb":[{"@type":"BreadcrumbList","numberOfItems":2,"itemListElement":[{"@type":"ListItem","position":1,"name":"YojnAI","item":{"@id":"https://daostudio.in/yojnai/"}},{"@type":"ListItem","position":2,"name":"Review a disputed answer","item":{"@id":"https://daostudio.in/yojnai/review-a-disputed-answer/"}}]}]},"description":"Use the application’s sources and intermediate work to locate what needs correcting before choosing an improvement.","text":"Review a disputed answer\nA reviewer says the supplier allows fourteen days, while the purchasing assistant returned thirty. Before changing the model, find the agreement and intermediate work behind that answer. The error may be in the source, the extraction or the choice of agreement version.\nNote\nIllustrative walkthrough. This purchase example explains YojnAI’s review and improvement design.\nFind the agreement behind the disputed term\nStart with the purchase, the application version and the agreement used for the disputed term. Check what the agreement said when the answer was produced, as well as whether it applied to this purchase.\nWhat you find\tWhat to investigate\t\nAnother supplier's agreement was retrieved\tSource selection\t\nThe applicable agreement says fourteen days, but extraction returned thirty\tThe input and operation that produced the unsupported value\t\nAn earlier agreement allowed thirty days\tHow the application chooses the applicable version\t\nAn older result replaced a corrected term\tThe request and revision associated with that late result\t\nSuppose the earlier agreement allowed thirty days, but the purchase was governed by its fourteen-day replacement. Extraction read its input correctly. Correct the draft to use the applicable agreement and keep that version beside the term. The improvement needs to address source selection; teaching extraction to return fourteen in every case would introduce another error.\nKeep useful work while reconsidering its dependents\nThe customer's delivery date can remain useful while the payment term changes. Reconsider the draft that uses the term, without asking for the date again or repeating unrelated work.\nA late response still belongs to the request and source it answered. Keeping it in the history helps explain what happened. Treating it as current could undo the correction. The composition account follows those dependencies through the wider purchase workflow.\nChoose the change that fixes the answer\nA useful change might correct a source, replace a tool, add a check, clarify an instruction, revise the workflow or adapt a model. A YojnAI feedback project keeps that question with the evidence being reviewed. Permission to review and the expertise behind a judgment remain separate.\nFor this purchase, compare two source-selection changes. One always prefers the newest agreement. The other chooses the agreement effective for the purchase date and returns that version with the term. Both could return fourteen days today; only the second has a reason to return thirty for a purchase governed by the earlier agreement. If the date is missing, it should ask rather than silently choose the newest document.\nTip\nCompare more than the reported failure. Try the proposed change against both purchases, an unresolved date and a late response. Check that it returns the applicable term, preserves the source and does not overwrite a correction. Also consider what it costs elsewhere: better selection that drops the evidence location makes review harder, and a stronger model may slow ordinary requests.\nThe review now has a specific proposal: choose by applicability, keep the agreement's identity and leave extraction alone when it reads the source correctly. Review the proposal and its results before choosing a version for the application. The application model places that choice within composition, deployment and feedback.\n","url":"https://daostudio.in/yojnai/review-a-disputed-answer/","publisher":{"@id":"https://daostudio.in/#organization","identifier":"organization:dspl","@type":"Organization","name":"DAO Studio Private Limited","url":"https://daostudio.in/","sameAs":[{"@id":"https://github.com/DAO-Studio"}]},"copyrightHolder":[{"@id":"https://daostudio.in/#organization"}],"about":[{"@id":"https://daostudio.in/yojnai/#entity","identifier":"project:yojnai","@type":"SoftwareApplication","name":"YojnAI","subjectOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"},{"@id":"https://daostudio.in/yojnai/compose-inspect-and-improve/#article","identifier":"content:dao-studio-yojnai-docs","@type":"TechArticle","name":"Compose, inspect and improve an application","url":"https://daostudio.in/yojnai/compose-inspect-and-improve/"},{"@id":"https://daostudio.in/yojnai/mentions/","identifier":"content:yojnai-mentions","@type":"CollectionPage","name":"YojnAI mentions","url":"https://daostudio.in/yojnai/mentions/"}]}],"isPartOf":[{"@id":"https://daostudio.in/yojnai/","identifier":"content:dao-studio-yojnai","@type":"CollectionPage","name":"YojnAI","url":"https://daostudio.in/yojnai/"}]},{"@context":{"@version":1.1,"@vocab":"https://schema.org/","url":{"@id":"https://schema.org/url","@type":"@id"}},"@id":"https://daostudio.in/blog/oldest/","@type":"CollectionPage","author":[{"@id":"https://getharsh.in/#person","@type":"Person","identifier":"person:harsh","name":"Harsh Joshi","sameAs":[{"@id":"https://github.com/getHarsh"},{"@id":"https://www.linkedin.com/in/getharsh/"}],"url":"https://getharsh.in/"}],"creativeWorkStatus":"published","description":"Composition, feedback, response and the questions behind DAO Studio's work.","identifier":"content:dao-studio-articles","inLanguage":"en","mainEntity":{"@type":"ItemList","itemListElement":[{"@type":"ListItem","item":{"@id":"https://daostudio.in/blog/the-organisation-around-the-ai/#article","@type":"Article","identifier":"content:dao-st